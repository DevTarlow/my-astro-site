---
import ContentImage from './ContentImage.astro'
import type { ProjectDisplay } from '../lib/project-browse'
import { categoryClass } from '../lib/project-browse'

export interface Props {
  item: ProjectDisplay
}

const { item } = Astro.props
const { project, href, shortTitle, month, category } = item
const datetime = project.data.pubDate.toISOString().slice(0, 10)
---

<a class="project-row" href={href}>
  <span class="project-row-thumb" aria-hidden="true">
    {
      project.data.image ? (
        <ContentImage
          src={project.data.image}
          alt=""
          sizes="96px"
          class="h-full w-full object-cover"
        />
      ) : (
        <span>{shortTitle.charAt(0)}</span>
      )
    }
  </span>

  <span class="project-row-main">
    <span class="project-row-title">{shortTitle}</span>
    <span class="project-row-desc">{project.data.description}</span>
  </span>

  <span class="project-row-meta">
    {category && <span class={categoryClass(category)}>{category}</span>}
    <time datetime={datetime}>{month}</time>
  </span>

  <span class="project-row-arrow" aria-hidden="true">↗</span>
</a>
