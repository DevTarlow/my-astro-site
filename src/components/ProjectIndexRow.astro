---
import ContentImage from './ContentImage.astro'
import type { ProjectDisplay } from '../lib/project-browse'
import { categoryClass } from '../lib/project-browse'

export interface Props {
  item: ProjectDisplay
}

const { item } = Astro.props
const { project, href, shortTitle, month, category } = item

// The compact index loses the screenshot at small widths; the row keeps its
// thumbnail from `sm` up so every project stays visually anchored.
const titleClass =
  'font-sans text-base text-ink no-underline transition-colors group-hover:text-terracotta'

const datetime = project.data.pubDate.toISOString().slice(0, 10)
const monthClass = 'font-mono text-[11px] uppercase tracking-wider text-muted'
---

<a
  href={href}
  class="group flex items-center gap-4 py-3 no-underline md:py-2.5"
>
  <span class="hidden shrink-0 overflow-hidden rounded border border-terracotta/10 sm:block">
    {
      project.data.image ? (
        <ContentImage
          src={project.data.image}
          alt=""
          sizes="96px"
          class="h-11 w-16 object-cover"
        />
      ) : (
        <span class="flex h-11 w-16 items-center justify-center bg-terracotta/10 font-mono text-sm text-terracotta">
          {shortTitle.charAt(0)}
        </span>
      )
    }
  </span>

  <!-- Below md the row stacks into two lines: title and month, then the
       description and category pill. Hiding the description on phones left
       the list as bare project names with nothing to click for. -->
  <span class="flex min-w-0 flex-1 flex-col gap-1 md:hidden">
    <span class="flex items-baseline justify-between gap-3">
      <span class={titleClass}>{shortTitle}</span>
      <time datetime={datetime} class={`shrink-0 ${monthClass}`}>{month}</time>
    </span>
    <span class="block text-sm text-muted line-clamp-2">{project.data.description}</span>
    {
      category && (
        <span class:list={['mt-0.5 self-start rounded px-1.5 py-0.5 text-xs', categoryClass(category)]}>
          {category}
        </span>
      )
    }
  </span>

  <span class:list={[titleClass, 'hidden w-56 shrink-0 md:block']}>{shortTitle}</span>

  <span class="hidden min-w-0 flex-1 md:block">
    <span class="block max-w-[46rem] text-sm text-muted line-clamp-2">{project.data.description}</span>
  </span>

  <span class="hidden shrink-0 items-center gap-3 text-xs md:flex">
    {
      category && (
        <span class:list={['hidden rounded px-1.5 py-0.5 sm:inline', categoryClass(category)]}>
          {category}
        </span>
      )
    }
    <time datetime={datetime} class={monthClass}>{month}</time>
  </span>
</a>
