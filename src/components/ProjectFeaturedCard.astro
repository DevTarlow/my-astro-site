---
import ContentImage from './ContentImage.astro'
import type { ProjectDisplay } from '../lib/project-browse'
import { categoryClass } from '../lib/project-browse'

export interface Props {
  item: ProjectDisplay
}

const { item } = Astro.props
const { project, href, shortTitle, monthYear, category } = item
const tags = (project.data.tags ?? []).slice(0, 4)
---

<article class="project-feature">
  {
    project.data.image ? (
      <a href={href} tabindex="-1" aria-hidden="true" class="project-feature-media">
        <ContentImage
          src={project.data.image}
          alt=""
          sizes="(max-width: 760px) 100vw, 300px"
          class="h-full w-full object-cover"
        />
      </a>
    ) : (
      <div class="project-feature-media project-placeholder" aria-hidden="true">
        {shortTitle.charAt(0)}
      </div>
    )
  }

  <div class="project-feature-copy">
    <div class="project-feature-meta">
      <time datetime={project.data.pubDate.toISOString().slice(0, 10)}>{monthYear}</time>
      {category && <span class={categoryClass(category)}>{category}</span>}
    </div>

    <h3 class="project-feature-title">
      <a href={href}>{shortTitle}</a>
    </h3>

    <p class="project-feature-desc">{project.data.description}</p>

    <div class="project-feature-foot">
      {
        tags.length > 0 && (
          <ul class="project-tags" aria-label="Tags">
            {tags.map((tag) => <li>#{tag}</li>)}
          </ul>
        )
      }
      <div class="project-actions">
        {
          project.data.github && (
            <a href={project.data.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          )
        }
        {
          project.data.url && (
            <a href={project.data.url} target="_blank" rel="noopener noreferrer">Visit ↗</a>
          )
        }
      </div>
    </div>
  </div>
</article>
