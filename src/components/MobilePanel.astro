---
import { getPublicBlog } from '../lib/posts'

const posts = await getPublicBlog()

const sorted = [...posts].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
)

const recent = sorted.slice(0, 5)

const path = Astro.url.pathname

const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
]
---

<div
  id="mobile-panel-overlay"
  data-menu-close
  class="fixed inset-0 z-40 bg-black/60 dark:bg-black/80 opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<div
  id="mobile-panel"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  aria-hidden="true"
  inert
  class="fixed inset-y-0 right-0 z-50 w-80 max-w-[85vw] bg-paper border-l border-terracotta/10 shadow-xl translate-x-full transition-transform duration-300 overflow-y-auto"
>
  <div class="sticky top-0 z-10 flex items-center justify-between bg-paper border-b border-terracotta/10 px-4 py-3">
    <h2 class="font-sans text-sm font-semibold text-ink tracking-tight">
      Menu
    </h2>
    <button
      id="mobile-panel-close"
      data-menu-close
      class="flex h-8 w-8 items-center justify-center rounded-md text-ink/50 transition-colors hover:bg-terracotta/10 hover:text-terracotta"
      aria-label="Close menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="p-4 flex flex-col gap-4">
    <nav class="flex flex-col gap-1 border-b border-terracotta/10 pb-4" aria-label="Mobile">
      {
        links.map(({ href, label }) => {
          const isActive = path === href || (href !== '/' && path.startsWith(href))
          return (
            <a
              href={href}
              class="font-sans text-lg tracking-tight no-underline py-2 px-1 rounded transition-colors duration-200 flex items-center justify-between group"
            >
              <span class={isActive ? 'text-terracotta' : 'text-ink group-hover:text-terracotta transition-colors'}>
                {label}
              </span>
              {isActive && <span class="text-terracotta text-xs">→</span>}
            </a>
          )
        })
      }
    </nav>

    <div class="border-b border-terracotta/10 pb-4">
      <button
        data-theme-toggle
        class="flex items-center gap-3 w-full py-2 px-1 rounded transition-colors duration-200 text-ink group"
      >
        <svg data-theme-sun xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden group-hover:text-terracotta transition-colors">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg data-theme-moon xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:text-terracotta transition-colors">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <span data-theme-label class="font-sans text-sm tracking-tight transition-colors">Dark Mode</span>
      </button>
    </div>

    <aside class="border border-terracotta/30 rounded-lg p-4 bg-paper/90">
      <h2 class="font-sans text-xs font-semibold text-terracotta uppercase tracking-widest mb-3">
        Recent Posts
      </h2>
      <ul class="space-y-3">
        {
          recent.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="group block no-underline">
                <span class="block text-sm font-medium text-ink group-hover:text-terracotta transition-colors leading-snug">
                  {post.data.title}
                </span>
                <time class="block text-[10px] text-ink/40 mt-0.5">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</div>

<script is:inline data-astro-rerun>
  // Slide-over menu controller. Delegated on document so it survives View
  // Transition navigation; data-astro-rerun re-runs it and swaps old handlers.
  (function () {
    const mq = window.matchMedia('(min-width: 768px)')
    const appShell = document.getElementById('app-shell')

    function panelEl () { return document.getElementById('mobile-panel') }
    function overlayEl () { return document.getElementById('mobile-panel-overlay') }
    function triggerEl () { return document.querySelector('[data-menu-trigger]') }

    function isOpen () {
      const panel = panelEl()
      return !!panel && !panel.classList.contains('translate-x-full')
    }

    function setOpen (open) {
      const wasOpen = isOpen()
      const panel = panelEl()
      const overlay = overlayEl()
      const trigger = triggerEl()
      if (!panel || !overlay) return

      if (open && !wasOpen) {
        overlay.classList.remove('opacity-0', 'pointer-events-none')
        overlay.removeAttribute('aria-hidden')
        panel.classList.remove('translate-x-full')
        panel.removeAttribute('aria-hidden')
        if (typeof panel.inert === 'boolean') panel.inert = false
        if (appShell && typeof appShell.inert === 'boolean') appShell.inert = true
        document.body.style.overflow = 'hidden'
        if (trigger) trigger.setAttribute('aria-expanded', 'true')
        const closeBtn = document.getElementById('mobile-panel-close')
        if (closeBtn) closeBtn.focus()
      } else if (!open && wasOpen) {
        overlay.classList.add('opacity-0', 'pointer-events-none')
        overlay.setAttribute('aria-hidden', 'true')
        panel.classList.add('translate-x-full')
        panel.setAttribute('aria-hidden', 'true')
        if (typeof panel.inert === 'boolean') panel.inert = true
        if (appShell && typeof appShell.inert === 'boolean') appShell.inert = false
        document.body.style.overflow = ''
        if (trigger) trigger.setAttribute('aria-expanded', 'false')
        if (!mq.matches && trigger) trigger.focus()
      }
    }

    function onClick (e) {
      if (e.target.closest('[data-menu-trigger]')) {
        setOpen(!isOpen())
        return
      }
      if (e.target.closest('[data-menu-close]')) {
        setOpen(false)
        return
      }
      // Clicking any link inside the panel navigates: close first so the app
      // shell is never left inert.
      const panel = panelEl()
      if (panel && panel.contains(e.target) && e.target.closest('a[href]')) {
        setOpen(false)
      }
    }

    function onKey (e) {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false)
        return
      }
      if (e.key === 'Tab' && isOpen()) {
        const panel = panelEl()
        if (!panel) return
        const focusables = panel.querySelectorAll(
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
        if (!focusables.length) return
        const first = focusables[0]
        const last = focusables[focusables.length - 1]
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault()
          last.focus()
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault()
          first.focus()
        }
      }
    }

    function onMqChange (e) {
      if (e.matches) setOpen(false)
    }

    if (window.__menuCleanup) window.__menuCleanup()
    const cleanup = function () {
      document.removeEventListener('click', onClick)
      document.removeEventListener('keydown', onKey)
      if (typeof mq.removeEventListener === 'function') {
        mq.removeEventListener('change', onMqChange)
      }
      window.__menuCleanup = null
    }
    window.__menuCleanup = cleanup

    document.addEventListener('click', onClick)
    document.addEventListener('keydown', onKey)
    if (typeof mq.addEventListener === 'function') {
      mq.addEventListener('change', onMqChange)
    }

    // The DOM is fresh after a navigation: force the closed state so a panel
    // that was open mid-transition never leaves the app shell inert.
    setOpen(false)
  })()
</script>
