---
const path = Astro.url.pathname

const links = [
  { href: '/', label: 'Home', match: null },
  { href: '/blog/', label: 'Journal', match: '/blog' },
  { href: '/#atlas', label: 'Atlas', match: null },
  { href: '/projects/', label: 'Work', match: '/projects' },
  { href: '/about/', label: 'About', match: '/about' },
]
---

<div
  id="mobile-panel"
  class="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Site index"
  hidden
>
  <div class="mobile-menu-top">
    <span class="wordmark">Tarlow<span class="dot">.</span></span>
    <button class="menu-close" type="button" data-menu-close>
      Close
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <nav class="mobile-nav" aria-label="Mobile navigation">
    {
      links.map(({ href, label, match }, index) => {
        const isActive = match ? path === match || path.startsWith(match + '/') : false
        return (
          <a href={href} aria-current={isActive ? 'page' : undefined}>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            {label === 'About' ? <em>{label}</em> : label}
          </a>
        )
      })
    }
  </nav>

  <div class="mobile-menu-foot">
    <p>
      45.52° N / 122.68° W<br />
      Portland, Oregon<br />
      <span data-local-time>--:--</span>
    </p>
    <div class="socials">
      <a href="https://github.com/DevTarlow/" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://bsky.app/profile/mossaistudio.bsky.social" target="_blank" rel="noopener noreferrer">Bluesky</a>
      <a href="https://x.com/MossAIStudio" target="_blank" rel="noopener noreferrer">X</a>
      <a href="/rss.xml">RSS</a>
      <a href="mailto:tarlow@mossaistudio.com">Email</a>
    </div>
  </div>
</div>

<script is:inline data-astro-rerun>
  (function () {
    if (window.__menuCleanup) window.__menuCleanup()

    const mq = window.matchMedia('(min-width: 1021px)')
    let savedFocus = null

    function panel () { return document.getElementById('mobile-panel') }
    function trigger () { return document.querySelector('[data-menu-trigger]') }
    function shell () { return document.getElementById('app-shell') }

    function isOpen () {
      const el = panel()
      return !!el && !el.hidden
    }

    function setOpen (open, restoreFocus) {
      const el = panel()
      if (!el) return
      const btn = trigger()
      const app = shell()
      const skip = document.querySelector('#skip-link')

      if (open) {
        if (isOpen()) return
        savedFocus = document.activeElement
        el.hidden = false
        if (btn) btn.setAttribute('aria-expanded', 'true')
        if (app) app.inert = true
        if (skip) skip.tabIndex = -1
        document.body.style.overflow = 'hidden'
        const close = el.querySelector('[data-menu-close]')
        if (close) close.focus()
      } else {
        el.hidden = true
        if (btn) btn.setAttribute('aria-expanded', 'false')
        if (app) app.inert = false
        if (skip) skip.tabIndex = 0
        document.body.style.overflow = ''
        if (restoreFocus !== false) {
          if (btn) btn.focus()
          else if (savedFocus instanceof HTMLElement) savedFocus.focus()
        }
      }
    }

    function onClick (event) {
      if (event.target.closest('[data-menu-trigger]')) {
        setOpen(!isOpen())
        return
      }
      if (event.target.closest('[data-menu-close]')) {
        setOpen(false)
        return
      }
      const el = panel()
      if (el && !el.hidden && el.contains(event.target) && event.target.closest('a[href]')) {
        setOpen(false, false)
      }
    }

    function onKey (event) {
      if (!isOpen()) return
      const el = panel()
      if (!el) return
      if (event.key === 'Escape') {
        event.preventDefault()
        setOpen(false)
        return
      }
      if (event.key !== 'Tab') return
      const focusable = Array.from(
        el.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
      ).filter(function (node) { return node.offsetParent !== null })
      if (!focusable.length) return
      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    }

    function onViewportChange (event) {
      if (event.matches) setOpen(false, false)
    }

    document.addEventListener('click', onClick)
    document.addEventListener('keydown', onKey)
    if (mq.addEventListener) mq.addEventListener('change', onViewportChange)

    // Start closed after every navigation. A View Transition can replace the
    // page while the menu is open, and the new page must not inherit a
    // scroll lock or an inert shell.
    setOpen(false, false)

    window.__menuCleanup = function () {
      document.removeEventListener('click', onClick)
      document.removeEventListener('keydown', onKey)
      if (mq.removeEventListener) mq.removeEventListener('change', onViewportChange)
      window.__menuCleanup = null
    }
  })()
</script>
