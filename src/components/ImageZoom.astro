<script is:inline>
  (function () {
    if (window.__imageZoomInit) return
    window.__imageZoomInit = true
    const style = document.createElement('style')
    style.textContent = 'article img{cursor:zoom-in}article a img{cursor:pointer}'
    document.head.appendChild(style)

    // Everything outside the dialog, so the page behind it cannot be reached by
    // keyboard or a screen reader while an image is open.
    const BACKGROUND = ['#app-shell', '#mobile-panel', '#mobile-panel-overlay', '#skip-link']

    function setBackgroundInert (inert) {
      for (const selector of BACKGROUND) {
        const el = document.querySelector(selector)
        if (!el) continue
        if (inert) el.setAttribute('inert', '')
        else el.removeAttribute('inert')
      }
    }

    // A View Transition can replace the page while the dialog is open, which
    // would leave the body scrolled-locked and the shell inert. Reset on load.
    document.addEventListener('astro:page-load', function () {
      if (document.querySelector('[data-image-zoom]')) return
      document.body.style.overflow = ''
      setBackgroundInert(false)
    })

    document.addEventListener('click', function (e) {
      const img = e.target.closest('article img')
      if (!img || img.closest('a')) return

      const src = img.getAttribute('src')
      const alt = img.getAttribute('alt') || ''

      const overlay = document.createElement('div')
      overlay.setAttribute('data-image-zoom', '')
      overlay.setAttribute('role', 'dialog')
      overlay.setAttribute('aria-modal', 'true')
      overlay.setAttribute('aria-label', 'Image preview')
      overlay.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.85);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.2s ease;'

      const closeBtn = document.createElement('button')
      closeBtn.type = 'button'
      closeBtn.setAttribute('aria-label', 'Close image preview')
      closeBtn.innerHTML = '<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
      closeBtn.style.cssText = 'position:absolute;top:1rem;right:1rem;background:none;border:none;cursor:pointer;width:2.75rem;height:2.75rem;display:flex;align-items:center;justify-content:center;z-index:1;border-radius:4px;'
      closeBtn.addEventListener('mouseenter', function () { closeBtn.style.background = 'rgba(255,255,255,0.1)' })
      closeBtn.addEventListener('mouseleave', function () { closeBtn.style.background = 'transparent' })
      overlay.appendChild(closeBtn)

      const fullImg = document.createElement('img')
      fullImg.src = src
      fullImg.alt = alt
      fullImg.style.cssText = 'max-width:95vw;max-height:95vh;object-fit:contain;border-radius:4px;box-shadow:0 4px 24px rgba(0,0,0,0.4);'
      overlay.appendChild(fullImg)

      document.body.appendChild(overlay)
      document.body.style.overflow = 'hidden'
      setBackgroundInert(true)

      requestAnimationFrame(function () { overlay.style.opacity = '1' })
      closeBtn.focus()

      function onKeydown (ev) {
        if (ev.key === 'Escape') {
          ev.preventDefault()
          close()
          return
        }
        // The close button is the only control in the dialog, so keep focus on
        // it rather than letting Tab escape to the inert page behind.
        if (ev.key === 'Tab') {
          ev.preventDefault()
          closeBtn.focus()
        }
      }

      function close () {
        document.removeEventListener('keydown', onKeydown)
        setBackgroundInert(false)
        overlay.style.opacity = '0'
        document.body.style.overflow = ''
        setTimeout(function () { overlay.remove() }, 200)
        // Hand focus back to the image that opened the dialog.
        if (img.isConnected) {
          img.setAttribute('tabindex', '-1')
          img.focus({ preventScroll: true })
        }
      }

      document.addEventListener('keydown', onKeydown)

      overlay.addEventListener('click', function (ev) {
        if (ev.target.tagName !== 'IMG') close()
      })
    })
  })()
</script>
