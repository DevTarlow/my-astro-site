---
import type { CollectionEntry } from 'astro:content'
import { dateParts } from '../lib/dates'

export interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props
---

{
  posts.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <p class="label"><span class="label-line" aria-hidden="true"></span>Continue reading</p>
      <h2 class="related-title" id="related-title">Nearby notes.</h2>
      <ul class="related-list">
        {posts.map((post) => (
          <li>
            <a class="related-row" href={`/blog/${post.id}/`}>
              <span class="related-date">{dateParts(post.data.pubDate).short}</span>
              <span class="related-copy">
                <span class="related-name">{post.data.title}</span>
              </span>
              <span class="related-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
