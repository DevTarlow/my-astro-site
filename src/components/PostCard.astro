---
import type { CollectionEntry } from 'astro:content'
import ContentImage from './ContentImage.astro'
import { dateParts } from '../lib/dates'
import { excerpt } from '../lib/excerpt'

export interface Props {
  post: CollectionEntry<'blog'>
  headingLevel?: 'h2' | 'h3'
}

const { post, headingLevel = 'h2' } = Astro.props
const Heading = headingLevel
const href = `/blog/${post.id}/`
const datetime = post.data.pubDate.toISOString().slice(0, 10)
const image = post.data.featuredimage
const summary = post.data.description || excerpt(post.body ?? '', 220)
const tags = (post.data.tags ?? []).slice(0, 1)
---

<article class="post-card">
  {
    image && (
      <a href={href} tabindex="-1" aria-hidden="true" class="post-card-media">
        <ContentImage
          src={image}
          alt=""
          sizes="(max-width: 640px) 96px, 172px"
          class="h-full w-full object-cover"
        />
      </a>
    )
  }
  <div class="post-card-body">
    <div class="post-card-meta">
      <time datetime={datetime}>{dateParts(post.data.pubDate).short}</time>
      {tags.length > 0 && <span class="post-card-tagline">{tags.join(' / ')}</span>}
    </div>
    <Heading class="post-card-title">
      <a href={href}>{post.data.title}</a>
    </Heading>
    <p class="post-card-excerpt">{summary}</p>
  </div>
</article>
