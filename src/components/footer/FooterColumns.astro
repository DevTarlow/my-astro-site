---
const year = new Date().getFullYear()

const explore = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Journal' },
  { href: '/projects/', label: 'Work' },
  { href: '/about/', label: 'About' },
]

const elsewhere = [
  { href: 'https://github.com/DevTarlow/', label: 'GitHub', external: true },
  { href: 'https://bsky.app/profile/mossaistudio.bsky.social', label: 'Bluesky', external: true },
  { href: 'https://x.com/MossAIStudio', label: 'X', external: true },
  { href: 'https://mossaistudio.com/', label: 'Moss AI Studio', external: true },
  { href: '/rss.xml', label: 'RSS' },
  { href: 'mailto:tarlow@mossaistudio.com', label: 'Email' },
]
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="wordmark" href="/">Tarlow<span class="dot">.</span></a>
        <p>
          A quiet record of building, attention, and the long way back. Local-first software, made slowly
          in Portland, Oregon.
        </p>
      </div>

      <div class="footer-col">
        <h2>Explore</h2>
        <ul>
          {explore.map(({ href, label }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h2>Elsewhere</h2>
        <ul>
          {elsewhere.map(({ href, label, external }) => (
            <li>
              <a
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                {label}{external && <span aria-hidden="true"> ↗</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Tarlow. All rights reserved.</span>
      <span class="sky-line">Made under the same sky</span>
      <span>Portland <span data-local-time>--:--</span></span>
    </div>
  </div>
</footer>
