---
const year = new Date().getFullYear()

const siteLinks = [
  { href: '/blog/', label: 'Journal' },
  { href: '/projects/', label: 'Work' },
  { href: '/about/', label: 'About' },
]

const elsewhere = [
  { href: 'https://github.com/DevTarlow/', label: 'GitHub', external: true },
  { href: 'https://bsky.app/profile/mossaistudio.bsky.social', label: 'Bluesky', external: true },
  { href: 'https://x.com/MossAIStudio', label: 'X', external: true },
  { href: 'https://mossaistudio.com/', label: 'Moss AI Studio', external: true },
  { href: '/rss.xml', label: 'RSS' },
  { href: 'mailto:tarlow@mossaistudio.com', label: 'Email' },
]
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="wordmark" href="/">Tarlow<span class="dot">.</span></a>
        <p>
          Ideas, a journal, and the passion to build. Tools made with intention in Portland, Oregon.
        </p>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <div class="footer-nav-group">
          {siteLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
        </div>
        <div class="footer-nav-group">
          {
            elsewhere.map(({ href, label, external }) => (
              <a
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                {label}{external && <span aria-hidden="true"> &nearr;</span>}
              </a>
            ))
          }
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} Tarlow. All rights reserved.</span>
      <span class="sky-line">Made under the same stars.</span>
      <span>Portland <span data-local-time>--:--</span></span>
    </div>
  </div>
</footer>
