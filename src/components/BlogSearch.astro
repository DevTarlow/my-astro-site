---
import { getPublicBlog } from '../lib/posts'
import { dateParts } from '../lib/dates'
import { getImageEntry } from '../lib/image-manifest'

const posts = await getPublicBlog()
const sorted = [...posts].sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

function thumbFor (src?: string) {
  if (!src) return null
  const entry = getImageEntry(src)
  if (!entry) return null
  const variant = entry.variants.find((v) => v.w === 640) ?? entry.variants[entry.variants.length - 1]
  if (!variant) return null
  return { url: variant.url, w: variant.w, h: variant.h }
}

const postsData = sorted.map(p => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  date: dateParts(p.data.pubDate).short,
  datetime: p.data.pubDate.toISOString().slice(0, 10),
  tags: p.data.tags ?? [],
  thumb: thumbFor(p.data.featuredimage),
}))
---

<div class="search-panel">
  <form id="search-form" role="search" class="search-form">
    <div class="search-heading">
      <label htmlFor="search-input" class="search-label">Find a note</label>
      <p id="search-scope" class="search-hint">Titles, descriptions, tags, and the full text of every entry.</p>
    </div>
    <div class="search-field-row">
      <div class="search-field">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="M16 16l4.5 4.5"></path>
        </svg>
        <input
          type="search"
          id="search-input"
          name="q"
          aria-label="Search posts"
          aria-describedby="search-scope"
          aria-controls="search-results"
          placeholder="Search the journal..."
          class="search-input"
        />
      </div>
      <button type="submit" class="search-submit">Search</button>
    </div>
  </form>
</div>

<script define:vars={{ postsData }} is:inline data-astro-rerun>
  (function () {
    function init () {
      const searchForm = document.getElementById('search-form')
      const searchInput = document.getElementById('search-input')
      const defaultContent = document.getElementById('default-content')
      const searchResults = document.getElementById('search-results')
      if (!searchForm || !searchInput || !defaultContent || !searchResults) return

      let bodyIndex = null
      let bodyIndexPromise = null
      let bodyIndexFailed = false

      function loadBodyIndex () {
        if (bodyIndexPromise) return bodyIndexPromise
        bodyIndexPromise = fetch('/search-index.json')
          .then(function (res) { return res.ok ? res.json() : {} })
          .then(function (data) { bodyIndex = data || {}; return bodyIndex })
          .catch(function () {
            bodyIndexFailed = true
            bodyIndex = {}
            return bodyIndex
          })
        return bodyIndexPromise
      }

      searchInput.addEventListener('focus', loadBodyIndex, { once: true })
      searchInput.addEventListener('input', loadBodyIndex, { once: true })

      searchResults.addEventListener('click', function (e) {
        if (e.target.closest('[data-clear]')) clearSearch()
      })

      function clearSearch () {
        searchInput.value = ''
        searchResults.classList.add('hidden')
        defaultContent.classList.remove('hidden')
        searchResults.innerHTML = ''
        searchInput.focus()
      }

      function escapeHtml (str) {
        if (!str) return ''
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
      }

      function clearButton () {
        return '<button data-clear class="search-clear" aria-label="Clear search">Clear search</button>'
      }

      function resultHtml (post) {
        let html = '<article class="post-card">'
        if (post.thumb) {
          html += '<a href="/blog/' + post.id + '/" tabindex="-1" aria-hidden="true" class="post-card-media">' +
            '<img src="' + escapeHtml(post.thumb.url) + '" width="' + post.thumb.w + '" height="' + post.thumb.h +
            '" alt="" loading="lazy" decoding="async" /></a>'
        }
        html += '<div class="post-card-body">'
        html += '<div class="post-card-meta"><time datetime="' + escapeHtml(post.datetime) + '">' + escapeHtml(post.date) + '</time>'
        if (post.tags.length) html += '<span class="post-card-tagline">' + escapeHtml(post.tags.slice(0, 3).join(' / ')) + '</span>'
        html += '</div>'
        html += '<h2 class="post-card-title"><a href="/blog/' + post.id + '/">' + escapeHtml(post.title) + '</a></h2>'
        html += '<p class="post-card-excerpt">' + escapeHtml(post.description) + '</p>'
        html += '</div></article>'
        return html
      }

      function haystackFor (post) {
        return [post.title, post.description, post.tags.join(' '), (bodyIndex && bodyIndex[post.id]) || ''].join(' ').toLowerCase()
      }

      searchForm.addEventListener('submit', async function (e) {
        e.preventDefault()
        const query = searchInput.value.trim().toLowerCase()
        if (!query) {
          clearSearch()
          return
        }

        if (!bodyIndex) await loadBodyIndex()

        const words = query.split(/\s+/)
        const matches = postsData.filter(function (post) {
          const haystack = haystackFor(post)
          return words.every(function (word) { return haystack.includes(word) })
        })

        if (matches.length === 0) {
          searchResults.innerHTML =
            '<div class="search-empty">' +
            '<p>No results for "<strong>' + escapeHtml(query) + '</strong>".</p>' +
            clearButton() +
            '</div>'
        } else {
          let html = '<div class="search-summary">'
          html += '<p>' + matches.length + ' result' + (matches.length !== 1 ? 's' : '') + ' for "<strong>' + escapeHtml(query) + '</strong>"</p>'
          html += clearButton()
          html += '</div>'
          if (bodyIndexFailed) {
            html += '<p class="search-note">Post text could not be loaded, so these results only cover titles, descriptions and tags.</p>'
          }
          html += '<div class="post-list">'
          matches.forEach(function (post) { html += resultHtml(post) })
          html += '</div>'
          searchResults.innerHTML = html
        }

        defaultContent.classList.add('hidden')
        searchResults.classList.remove('hidden')
      })
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true })
    } else {
      init()
    }
  })()
</script>
