---
import { getPublicBlog } from '../lib/posts'
import type { CollectionEntry } from 'astro:content'

const posts = await getPublicBlog()

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']

const pad = (n: number) => String(n).padStart(2, '0')
const dateKey = (d: Date) => `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`
const fmtDate = (d: Date) => `${MONTHS[d.getUTCMonth()]} ${d.getUTCDate()}, ${d.getUTCFullYear()}`

// Group posts by publish date (UTC day - frontmatter dates are parsed as UTC midnight)
const byDate = new Map<string, CollectionEntry<'blog'>[]>()
for (const post of posts) {
  const key = dateKey(post.data.pubDate)
  const list = byDate.get(key) ?? []
  list.push(post)
  byDate.set(key, list)
}

// 6-month window: 26 full weeks + the current week, Sunday start (GitHub style)
const now = new Date()
const today = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()))
const todaySunday = new Date(today)
todaySunday.setUTCDate(todaySunday.getUTCDate() - todaySunday.getUTCDay())
const start = new Date(todaySunday)
start.setUTCDate(start.getUTCDate() - 26 * 7)

const weeks: Date[][] = []
const cursor = new Date(start)
while (cursor.getTime() <= todaySunday.getTime()) {
  const week: Date[] = []
  for (let i = 0; i < 7; i++) {
    week.push(new Date(cursor))
    cursor.setUTCDate(cursor.getUTCDate() + 1)
  }
  weeks.push(week)
}

// Drop future days from the current week so the grid never renders empty cells
// for days that have not happened yet (GitHub hides them too).
const lastWeek = weeks[weeks.length - 1]
if (lastWeek) {
  weeks[weeks.length - 1] = lastWeek.filter((date) => date.getTime() <= today.getTime())
}

// Month label above the first week column that contains the 1st of a new month
// (GitHub's rule: a column is labeled with the month of its last day, Saturday,
// so the label lands on the week the month actually begins in)
let lastMonth = -1
const monthLabels = weeks.map((week) => {
  const lastDay = week[week.length - 1]
  if (!lastDay) return ''
  const m = lastDay.getUTCMonth()
  if (m !== lastMonth) {
    lastMonth = m
    return MONTHS[m]
  }
  return ''
})

// 0 = empty, 1-2 = light, 3 = medium, 4+ = full (GitHub's 5-level scale)
const LEVELS = [
  'bg-ink/10',
  'bg-terracotta/40',
  'bg-terracotta/65',
  'bg-terracotta/85',
  'bg-terracotta',
]
const level = (count: number) => (count === 0 ? 0 : Math.min(4, count))

const DAY_LABELS = ['', 'Mon', '', 'Wed', '', 'Fri', '']

// Cells shrink on small screens so the 6-month grid fits a 390px viewport
// without horizontal scrolling (27 columns x 10px + rail fits in ~296px).
const CELL = 'h-2 w-2 rounded-[2px] sm:h-[10px] sm:w-[10px]'
const GAP = 'gap-[2px] sm:gap-[3px]'
const RAIL = 'w-6 sm:w-7'

// Anchor edge columns inward so a tooltip never widens the scroll container.
function tooltipAlign (weekIndex: number, totalWeeks: number): string {
  if (weekIndex >= totalWeeks - 2) return 'right-0'
  if (weekIndex > 1) return 'left-1/2 -translate-x-1/2'
  return 'left-0'
}

// Tooltip placement: top rows (Sun/Tue) flip the tooltip below the cell so
// the scroll container never clips the title (GitHub anchors below too)
---

<div class="mt-10 pt-8 pb-2">
  <div class="mx-auto w-max max-w-full">
    <p class="mb-3 text-xs text-muted">{posts.length} posts in the last 6 months</p>

    <!-- The grid is hidden below sm: it cannot fit a 390px viewport without
         horizontal scrolling, and the count line above carries the same signal.
         The grid itself is ~376px wide, so no scroll container is needed; letting
         it overflow visibly keeps edge tooltips readable instead of clipped. -->
    <div class="hidden overflow-visible sm:block">
      <div class="w-max">
        <div class="flex">
          <div class={`${RAIL} shrink-0`} aria-hidden="true"></div>
          <div class={`flex ${GAP}`}>
            {
              monthLabels.map((label) => (
                <div class={`w-2 whitespace-nowrap text-[10px] leading-[13px] text-muted sm:w-[10px]`} aria-hidden="true">
                  {label}
                </div>
              ))
            }
          </div>
        </div>

        <div class="mt-[3px] flex">
          <div
            class={`flex ${RAIL} shrink-0 flex-col ${GAP} pr-1 text-[10px] leading-[10px] text-muted`}
            aria-hidden="true"
          >
            {
              DAY_LABELS.map((label) => (
                <span class="h-2 sm:h-[10px]">{label}</span>
              ))
            }
          </div>

          <div class={`flex ${GAP}`}>
            {
              weeks.map((week, weekIndex) => (
                <div class={`flex flex-col ${GAP}`}>
                  {
                    week.map((date, dayIndex) => {
                      const entry = byDate.get(dateKey(date))
                      if (!entry) {
                        return <div class={`${CELL} bg-ink/20 dark:bg-ink/15`} aria-hidden="true"></div>
                      }
                      const n = entry.length
                      const label = `${n} ${n === 1 ? 'post' : 'posts'} on ${fmtDate(date)}`
                      const tooltipPos = dayIndex >= 3 ? 'bottom-full mb-2' : 'top-full mt-2'
                      return (
                        <div class="group relative" data-graph-cell>
                          <button
                            type="button"
                            class={`${CELL} ${LEVELS[level(n)]} outline-none focus-visible:ring-2 focus-visible:ring-terracotta/60`}
                            aria-label={label}
                          ></button>
                          <div
                            data-graph-tooltip
                            class={`pointer-events-none absolute z-20 w-max max-w-[300px] rounded-md bg-ink px-3 py-2 text-xs text-paper opacity-0 shadow-lg transition-opacity duration-100 group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100 group-[.open]:pointer-events-auto group-[.open]:opacity-100 ${tooltipPos} ${tooltipAlign(weekIndex, weeks.length)}`}
                          >
                            <span class="block font-medium">{label}</span>
                            <span class="mt-1 block space-y-1">
                              {
                                entry.map((post) => (
                                  <a
                                    href={`/blog/${post.id}/`}
                                    class="block break-words font-medium text-paper/90 underline decoration-paper/40 underline-offset-2 hover:text-terracotta hover:decoration-terracotta/60"
                                  >
                                    {post.data.title}
                                  </a>
                                ))
                              }
                            </span>
                          </div>
                        </div>
                      )
                    })
                  }
                </div>
              ))
            }
          </div>
        </div>

        <div class={`mt-3 flex items-center justify-end ${GAP} text-[10px] text-muted`}>
          <span class="mr-1">Less</span>
          <span class={`${CELL} bg-ink/20 dark:bg-ink/15`}></span>
          <span class={`${CELL} bg-terracotta/40`}></span>
          <span class={`${CELL} bg-terracotta/65`}></span>
          <span class={`${CELL} bg-terracotta/85`}></span>
          <span class={`${CELL} bg-terracotta`}></span>
          <span class="ml-1">More</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // Tap-to-show tooltips (mobile) + click-anywhere-to-close.
  // Delegated on document so it survives View Transition navigation;
  // guarded so handlers are never registered twice.
  const initPostGraphTaps = () => {
    if (window.__postGraphTaps) return
    window.__postGraphTaps = true
    document.addEventListener('click', (e) => {
      const open = document.querySelectorAll('[data-graph-cell].open')
      const cell = e.target.closest('[data-graph-cell]')
      if (!cell) {
        open.forEach((c) => c.classList.remove('open'))
        return
      }
      // Clicked a post link inside a tooltip - let it navigate, close the rest
      if (e.target.closest('[data-graph-tooltip]')) {
        open.forEach((c) => c.classList.remove('open'))
        return
      }
      open.forEach((c) => {
        if (c !== cell) c.classList.remove('open')
      })
      cell.classList.toggle('open')
    })
  }
  initPostGraphTaps()
</script>
