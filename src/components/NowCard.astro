---
import { NOW } from '../lib/site'
---

<div class="now-card">
  <p class="label">Now / {NOW.label}</p>
  <ul class="now-list">
    <li>
      <span class="now-key">Building</span>
      <span class="now-value">
        {NOW.building.map((item, index) => (
          <span class="now-building">
            {index > 0 && <span class="now-sep" aria-hidden="true"> + </span>}
            <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>
          </span>
        ))}
      </span>
    </li>
    <li><span class="now-key">Practicing</span><span class="now-value">{NOW.practicing}</span></li>
    <li><span class="now-key">At home</span><span class="now-value">{NOW.home}</span></li>
    <li><span class="now-key">Open to</span><span class="now-value">{NOW.openTo}</span></li>
  </ul>
  <a class="text-link" href="/about/">
    The long way back
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </a>
</div>
