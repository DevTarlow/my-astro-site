<button
  id="back-to-top"
  tabindex="-1"
  aria-hidden="true"
  class="invisible fixed bottom-6 right-6 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-terracotta text-paper shadow-md opacity-0 pointer-events-none transition-opacity duration-200 hover:opacity-90"
  aria-label="Back to top"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

<script is:inline>
  // Delegated on document so the click/scroll handling survives View
  // Transition navigation (the button node is recreated on each page).
  (function () {
    if (window.__backToTopInit) return
    window.__backToTopInit = true

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

    function menuOpen () {
      return document.body.style.overflow === 'hidden'
    }

    function update () {
      const btn = document.getElementById('back-to-top')
      if (!btn) return
      const visible = window.scrollY > 400 && !menuOpen()
      btn.classList.toggle('opacity-0', !visible)
      btn.classList.toggle('pointer-events-none', !visible)
      // visibility:hidden also removes the button from the tab order so
      // keyboard users never land on an invisible control.
      btn.classList.toggle('invisible', !visible)
      btn.tabIndex = visible ? 0 : -1
      btn.setAttribute('aria-hidden', visible ? 'false' : 'true')
    }

    function onClick (e) {
      if (!e.target.closest('#back-to-top')) return
      window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' })
    }

    window.addEventListener('scroll', update, { passive: true })
    document.addEventListener('click', onClick)
    document.addEventListener('astro:page-load', update)
    update()
  })()
</script>
