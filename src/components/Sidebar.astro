---
import { getPublicBlog } from '../lib/posts'
import { dateParts } from '../lib/dates'

export interface Props {
  showRecent?: boolean
}

const { showRecent = true } = Astro.props
const posts = await getPublicBlog()
const sorted = [...posts].sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
const recent = sorted.slice(0, 5)

const tagCounts = new Map<string, number>()
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)
  }
}
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8)
---

<div class="journal-sidebar">
  {
    showRecent ? (
      <section class="sidebar-card">
        <p class="sidebar-kicker">Recently</p>
        <h2 class="sidebar-title">Still on the desk.</h2>
        <ul class="sidebar-recent">
          {recent.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <span>{post.data.title}</span>
                <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                  {dateParts(post.data.pubDate).short}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : (
      <section class="sidebar-card">
        <p class="sidebar-kicker">About</p>
        <h2 class="sidebar-title">A quiet corner of the web.</h2>
        <p class="sidebar-copy">
          I'm Tarlow, a solo developer in the Pacific Northwest building tools and writing about what I
          learn along the way.
        </p>
        <a class="text-link" href="/about/">
          The long way back
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </section>
    )
  }

  {
    sortedTags.length > 0 && (
      <section class="sidebar-card">
        <p class="sidebar-kicker">Browse by tag</p>
        <ul class="tag-cloud">
          {sortedTags.map(([tag, count]) => (
            <li>
              <a class="tag-chip" href={`/blog/tags/${encodeURIComponent(tag)}/`}>
                #{tag} <span>{count}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="text-link" href="/blog/tags/">
          All tags
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </section>
    )
  }
</div>
