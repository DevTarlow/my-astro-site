---
import { getPublicBlog } from '../lib/posts'

export interface Props {
  /**
   * On blog page 1 the main column already lists the five newest posts, so the
   * Recent Posts block would be a duplicate. Pages 2+ show older posts and do
   * benefit from it.
   */
  showRecent?: boolean
}

const { showRecent = true } = Astro.props

const posts = await getPublicBlog()

const sorted = [...posts].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
)

const recent = sorted.slice(0, 5)

const tagCounts = new Map<string, number>()
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)
  }
}
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8)
---

<div class="flex flex-col gap-4 lg:sticky lg:top-8">
  {
    showRecent ? (
      <aside class="border border-terracotta/30 rounded-lg p-4 bg-paper/90 backdrop-blur supports-[backdrop-filter]:bg-paper/80">
        <h2 class="font-sans text-xs font-semibold text-terracotta uppercase tracking-widest mb-3">
          Recent Posts
        </h2>
        <ul class="space-y-3">
          {recent.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="group block no-underline">
                <span class="block text-sm font-medium text-ink group-hover:text-terracotta transition-colors leading-snug">
                  {post.data.title}
                </span>
                <time class="block text-[10px] text-muted mt-0.5">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <span class="block text-xs text-muted mt-1 leading-normal line-clamp-2">
                  {post.data.description}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    ) : (
      <aside class="border border-terracotta/30 rounded-lg p-4 bg-paper/90 backdrop-blur supports-[backdrop-filter]:bg-paper/80">
        <h2 class="font-sans text-xs font-semibold text-terracotta uppercase tracking-widest mb-3">
          About
        </h2>
        <p class="text-sm text-muted leading-relaxed">
          Developer in the Pacific Northwest building local-first tools and writing
          about what I learn along the way.
        </p>
        <a
          href="/about/"
          class="mt-3 inline-block text-[11px] text-terracotta no-underline hover:opacity-80 transition-opacity"
        >
          More about me →
        </a>
      </aside>
    )
  }

  {
    sortedTags.length > 0 && (
      <aside class="border border-terracotta/30 rounded-lg p-4 bg-paper/90 backdrop-blur supports-[backdrop-filter]:bg-paper/80">
        <h2 class="font-sans text-xs font-semibold text-terracotta uppercase tracking-widest mb-3">
          Browse by Tag
        </h2>
        <div class="flex flex-wrap gap-2">
          {
            sortedTags.map(([tag, count]) => (
              <a
                href={`/blog/tags/${encodeURIComponent(tag)}/`}
                class="inline-flex items-center gap-1 text-xs text-terracotta bg-terracotta/5 px-2 py-1 rounded no-underline hover:bg-terracotta/10 transition-colors"
              >
                #{tag}
                <span class="text-[10px] text-muted">{count}</span>
              </a>
            ))
          }
        </div>
        <a
          href="/blog/tags/"
          class="mt-3 inline-block text-[11px] text-terracotta no-underline hover:opacity-80 transition-opacity"
        >
          View all →
        </a>
      </aside>
    )
  }
</div>
