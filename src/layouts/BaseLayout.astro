---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import Navbar from '../components/Navbar.astro'
import MobilePanel from '../components/MobilePanel.astro'
import BackToTop from '../components/BackToTop.astro'
import ConsentBanner from '../components/ConsentBanner.astro'
import Footer from '../components/footer/FooterColumns.astro'
import { getImageEntry } from '../lib/image-manifest'

export interface Props {
  title?: string
  description?: string
  image?: string
  ogType?: 'website' | 'article' | 'profile'
  /** Emit robots noindex and no canonical (the 404 page). */
  noindex?: boolean
  /** ISO date, for `og:type=article` pages. */
  publishedTime?: string
  articleTags?: string[]
  /** schema.org data; rendered as one or more ld+json blocks. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const {
  title,
  description,
  image,
  ogType = 'website',
  noindex = false,
  publishedTime,
  articleTags = [],
  jsonLd,
} = Astro.props

const siteUrl = 'https://tarlow.space'
const siteName = 'Tarlow.space'
const pageTitle = title ? `${title} - ${siteName} | Developer` : `${siteName} | Developer`
const defaultDesc = 'A blog about Tarlows projects, local-first tools, and AI exploration.'
const pageDesc = description || defaultDesc

function absUrl(src: string): string {
  if (src.startsWith('http://') || src.startsWith('https://')) return src
  return siteUrl + src
}

// Pages without an explicit image get the generated 1200x630 card, so a share
// of any page fills a large-card unfurl instead of cropping a portrait.
const DEFAULT_OG = '/images/og-default.png'
const ogImage = absUrl(image || DEFAULT_OG)

// Dimensions are only declared when they are actually known: the generated card
// is fixed, and anything else comes from the build-time image manifest.
const ogEntry = image ? getImageEntry(image) : null
const ogDimensions = image
  ? (ogEntry ? { width: ogEntry.width, height: ogEntry.height } : null)
  : { width: 1200, height: 630 }

const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
// `<` is escaped so a post title can never close the script tag early.
const serialize = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        let stored = null
        try { stored = localStorage.getItem('theme') } catch { /* storage may be unavailable */ }
        const dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches
        if (dark) {
          document.documentElement.classList.add('dark')
        }
      })()
    </script>
    <script is:inline>
      // Reveals the consent banner before paint, but only when no choice has
      // been stored yet (see the .consent-banner rules in global.css).
      (function () {
        try {
          if (!localStorage.getItem('analytics-consent')) {
            document.documentElement.classList.add('consent-pending')
          }
        } catch { /* storage may be unavailable */ }
      })()
    </script>
    <ClientRouter />
    <!-- Google tag (gtag.js). Analytics sets cookies, so nothing is loaded until
         the visitor allows it: the library is ~170KB and is fetched after load +
         idle once consent is stored. The dataLayer queue is flushed on arrival. -->
    <script is:inline>
      (function () {
        const MEASUREMENT_ID = 'G-H879GPJ4GM'
        const CONSENT_KEY = 'analytics-consent'

        function readConsent () {
          try { return localStorage.getItem(CONSENT_KEY) } catch { return null }
        }

        function writeConsent (value) {
          try { localStorage.setItem(CONSENT_KEY, value) } catch { /* storage may be unavailable */ }
        }

        function enableAnalytics () {
          if (window.__gaEnabled) return
          window.__gaEnabled = true

          window.dataLayer = window.dataLayer || []
          window.gtag = function (...args) { window.dataLayer.push(args) }
          window.gtag('js', new Date())
          window.gtag('config', MEASUREMENT_ID)

          const script = document.createElement('script')
          script.async = true
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + MEASUREMENT_ID
          document.head.appendChild(script)
        }

        window.__enableAnalytics = enableAnalytics

        if (readConsent() === 'granted') {
          const schedule = function () {
            if (typeof window.requestIdleCallback === 'function') {
              window.requestIdleCallback(enableAnalytics, { timeout: 3000 })
            } else {
              setTimeout(enableAnalytics, 1500)
            }
          }
          if (document.readyState === 'complete') schedule()
          else window.addEventListener('load', schedule, { once: true })
        }

        document.addEventListener('astro:page-load', function () {
          // Astro's router copies the next page's <html> attributes onto the
          // live root, which strips `consent-pending`, and this head script does
          // not re-run. Without re-applying it here, a reader who clicks any
          // internal link before answering would never see the notice again.
          if (!readConsent()) document.documentElement.classList.add('consent-pending')
          if (window.__gaEnabled) {
            window.gtag('config', MEASUREMENT_ID, { page_path: location.pathname })
          }
        })

        // Delegated so it survives View Transition navigation, which recreates
        // the banner element on every page.
        if (window.__consentHandlers) {
          document.removeEventListener('click', window.__consentHandlers.click)
        }
        const handleClick = function (e) {
          if (!e.target.closest('[data-consent-accept], [data-consent-decline]')) return
          const accept = !!e.target.closest('[data-consent-accept]')
          writeConsent(accept ? 'granted' : 'denied')
          document.documentElement.classList.remove('consent-pending')
          if (accept) enableAnalytics()
        }
        window.__consentHandlers = { click: handleClick }
        document.addEventListener('click', handleClick)
      })()
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F9F9F8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0D0D0D" media="(prefers-color-scheme: dark)" />

    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl)} />}
    <link rel="alternate" type="application/rss+xml" title="Tarlow.space" href="/rss.xml" />

    <meta name="description" content={pageDesc} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteUrl)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={image ? pageTitle : 'Tarlow, developer in the Pacific Northwest'} />
    {
      ogDimensions && (
        <>
          <meta property="og:image:width" content={String(ogDimensions.width)} />
          <meta property="og:image:height" content={String(ogDimensions.height)} />
        </>
      )
    }
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content="Tarlow" />}
    {articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={image ? pageTitle : 'Tarlow, developer in the Pacific Northwest'} />
    {jsonLdBlocks.map((block) => <script is:inline type="application/ld+json" set:html={serialize(block)} />)}
  </head>
  <body class="bg-paper">
    <!-- Keyboard users land here first; it slides in on focus and is plain
         off-screen the rest of the time. Kept out of `sr-only` because mixing
         `not-sr-only` with a positioning utility is order-dependent. -->
    <a
      id="skip-link"
      href="#main-content"
      class="absolute left-4 top-4 z-[100] -translate-y-20 rounded-md bg-terracotta px-4 py-2 font-sans text-sm font-medium text-paper no-underline shadow-lg transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    <div class="bg-paper text-ink font-sans leading-relaxed antialiased min-h-screen">
      <div id="app-shell">
        <Navbar />
        <slot />
        <Footer />
        <BackToTop />
        <!-- Inside the shell so the mobile panel's scrim covers it and it goes
             inert with everything else while the menu is open. -->
        <ConsentBanner />
      </div>
      <MobilePanel />
    </div>

    <!-- Single theme controller: delegated so it survives View Transition navigation.
         Re-runs on every navigation (data-astro-rerun) and swaps the old handler.
         Astro's router copies the next page's <html> attributes onto the live root,
         which strips class="dark" on client-side navigation - so applyTheme() must
         re-run on every page load. -->
    <script is:inline data-astro-rerun>
      (function () {
        function currentDark () {
          return document.documentElement.classList.contains('dark')
        }

        function desiredDark () {
          let stored = null
          try { stored = localStorage.getItem('theme') } catch { /* storage may be unavailable */ }
          return stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches
        }

        function persistTheme (dark) {
          try { localStorage.setItem('theme', dark ? 'dark' : 'light') } catch { /* storage may be unavailable */ }
        }

        function syncControls (dark) {
          document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
            const sun = btn.querySelector('[data-theme-sun]')
            const moon = btn.querySelector('[data-theme-moon]')
            const label = btn.querySelector('[data-theme-label]')
            if (sun) sun.classList.toggle('hidden', !dark)
            if (moon) moon.classList.toggle('hidden', dark)
            if (label) label.textContent = dark ? 'Light Mode' : 'Dark Mode'
          })
        }

        function setTheme (dark) {
          document.documentElement.classList.toggle('dark', dark)
          persistTheme(dark)
          syncControls(dark)
        }

        // Restore the stored/system theme without persisting anything.
        // Runs once per navigation to undo the router's attribute swap.
        function applyTheme () {
          const dark = desiredDark()
          document.documentElement.classList.toggle('dark', dark)
          syncControls(dark)
        }

        applyTheme()

        if (window.__themeHandlers) {
          document.removeEventListener('click', window.__themeHandlers.click)
        }
        const handleClick = function (e) {
          if (!e.target.closest('[data-theme-toggle]')) return
          setTheme(!currentDark())
        }
        window.__themeHandlers = { click: handleClick }
        document.addEventListener('click', handleClick)

        if (window.__themeOnPageLoad) {
          document.removeEventListener('astro:page-load', window.__themeOnPageLoad)
        }
        window.__themeOnPageLoad = applyTheme
        document.addEventListener('astro:page-load', applyTheme)
      })()
    </script>
  </body>
</html>
