---
import '../styles/global.css'
import '../styles/observatory.css'
import '../styles/field-journal.css'
import { ClientRouter } from 'astro:transitions'
import Navbar from '../components/Navbar.astro'
import MobilePanel from '../components/MobilePanel.astro'
import BackToTop from '../components/BackToTop.astro'
import ConsentBanner from '../components/ConsentBanner.astro'
import Sky from '../components/Sky.astro'
import SiteScripts from '../components/SiteScripts.astro'
import Footer from '../components/footer/FooterColumns.astro'
import { getImageEntry } from '../lib/image-manifest'

export interface Props {
  title?: string
  description?: string
  image?: string
  ogType?: 'website' | 'article' | 'profile'
  /** Emit robots noindex and no canonical (the 404 page). */
  noindex?: boolean
  /** ISO date, for `og:type=article` pages. */
  publishedTime?: string
  articleTags?: string[]
  /** schema.org data; rendered as one or more ld+json blocks. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /** Drives the fixed sky level and the article progress bar. */
  view?: 'home' | 'essay' | 'about' | 'page'
  /** Extra body classes, for page-specific scopes. */
  bodyClass?: string
}

const {
  title,
  description,
  image,
  ogType = 'website',
  noindex = false,
  publishedTime,
  articleTags = [],
  jsonLd,
  view = 'page',
  bodyClass,
} = Astro.props

const siteUrl = 'https://tarlow.space'
const siteName = 'Tarlow.space'
const pageTitle = title ? `${title} - ${siteName}` : `${siteName} - quiet tools, a slower life`
const defaultDesc = 'A field journal from Tarlow, a solo developer in Portland, Oregon. Local-first tools, a slower way of building, and a look in the past.'
const pageDesc = description || defaultDesc

function absUrl(src: string): string {
  if (src.startsWith('http://') || src.startsWith('https://')) return src
  return siteUrl + src
}

// Pages without an explicit image get the generated 1200x630 card, so a share
// of any page fills a large-card unfurl instead of cropping a portrait.
const DEFAULT_OG = '/images/og-default.png'
const ogImage = absUrl(image || DEFAULT_OG)

// Dimensions are only declared when they are actually known: the generated card
// is fixed, and anything else comes from the build-time image manifest.
const ogEntry = image ? getImageEntry(image) : null
const ogDimensions = image
  ? (ogEntry ? { width: ogEntry.width, height: ogEntry.height } : null)
  : { width: 1200, height: 630 }

const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
// `<` is escaped so a post title can never close the script tag early.
const serialize = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <ClientRouter />
    <!-- Google tag (gtag.js). Analytics sets cookies, so nothing is loaded until
         the visitor allows it: the library is ~170KB and is fetched after load +
         idle once consent is stored. The dataLayer queue is flushed on arrival. -->
    <script is:inline>
      (function () {
        const MEASUREMENT_ID = 'G-H879GPJ4GM'
        const CONSENT_KEY = 'analytics-consent'

        function readConsent () {
          try { return localStorage.getItem(CONSENT_KEY) } catch { return null }
        }

        function writeConsent (value) {
          try { localStorage.setItem(CONSENT_KEY, value) } catch { /* storage may be unavailable */ }
        }

        function enableAnalytics () {
          if (window.__gaEnabled) return
          window.__gaEnabled = true

          window.dataLayer = window.dataLayer || []
          window.gtag = function (...args) { window.dataLayer.push(args) }
          window.gtag('js', new Date())
          window.gtag('config', MEASUREMENT_ID)

          const script = document.createElement('script')
          script.async = true
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + MEASUREMENT_ID
          document.head.appendChild(script)
        }

        window.__enableAnalytics = enableAnalytics

        if (readConsent() === 'granted') {
          const schedule = function () {
            if (typeof window.requestIdleCallback === 'function') {
              window.requestIdleCallback(enableAnalytics, { timeout: 3000 })
            } else {
              setTimeout(enableAnalytics, 1500)
            }
          }
          if (document.readyState === 'complete') schedule()
          else window.addEventListener('load', schedule, { once: true })
        }

        document.addEventListener('astro:page-load', function () {
          // Astro's router copies the next page's <html> attributes onto the
          // live root, which can strip the consent marker. Re-apply it when no
          // choice is stored so a reader who navigates before answering still
          // sees the notice.
          if (!readConsent()) document.documentElement.classList.add('consent-pending')
          if (window.__gaEnabled) {
            window.gtag('config', MEASUREMENT_ID, { page_path: location.pathname })
          }
        })

        // Delegated so it survives View Transition navigation, which recreates
        // the banner element on every page.
        if (window.__consentHandlers) {
          document.removeEventListener('click', window.__consentHandlers.click)
        }
        const handleClick = function (e) {
          if (!e.target.closest('[data-consent-accept], [data-consent-decline]')) return
          const accept = !!e.target.closest('[data-consent-accept]')
          writeConsent(accept ? 'granted' : 'denied')
          document.documentElement.classList.remove('consent-pending')
          if (accept) enableAnalytics()
        }
        window.__consentHandlers = { click: handleClick }
        document.addEventListener('click', handleClick)

        // Reveal the banner before paint only when no choice is stored.
        try {
          if (!localStorage.getItem(CONSENT_KEY)) {
            document.documentElement.classList.add('consent-pending')
          }
        } catch { /* storage may be unavailable */ }
      })()
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#05070C" />

    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-latin-italic.woff2" as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl)} />}
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <meta name="description" content={pageDesc} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteUrl)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={image ? pageTitle : 'Tarlow, independent developer in the Pacific Northwest'} />
    {
      ogDimensions && (
        <>
          <meta property="og:image:width" content={String(ogDimensions.width)} />
          <meta property="og:image:height" content={String(ogDimensions.height)} />
        </>
      )
    }
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content="Tarlow" />}
    {articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={image ? pageTitle : 'Tarlow, independent developer in the Pacific Northwest'} />
    {jsonLdBlocks.map((block) => <script is:inline type="application/ld+json" set:html={serialize(block)} />)}
  </head>
  <body data-view={view} class={bodyClass}>
    <a id="skip-link" class="skip-link" href="#main-content">Skip to content</a>

    <Sky />

    <div id="app-shell">
      <Navbar />
      <slot />
      <Footer />
      <BackToTop />
      <ConsentBanner />
    </div>

    <MobilePanel />
    <SiteScripts />
  </body>
</html>
