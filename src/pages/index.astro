---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPublicBlog, getPublicProjects } from '../lib/posts'
import { dateParts } from '../lib/dates'
import { readingMinutes } from '../lib/reading'
import { NOW, nowMonth } from '../lib/site'
import ContentImage from '../components/ContentImage.astro'

const posts = await getPublicBlog()
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

const allProjects = await getPublicProjects()
const projectsById = new Map(allProjects.map((project) => [project.id, project]))
const selectedProjects = [
  'marimo-bot',
  'pixel-juice-studio',
  'background-swapper',
  'moss-toolbox',
  'x-buddy',
]
  .map((id) => projectsById.get(id))
  .filter((project): project is NonNullable<typeof project> => Boolean(project))
const workProjects = selectedProjects.length > 0 ? selectedProjects : allProjects.slice(0, 5)

const latestPost = posts[0]!
const recent = posts.slice(1, 4)

const latestDate = dateParts(latestPost.data.pubDate).long
const latestMinutes = readingMinutes(latestPost.body)
const latestTag = (latestPost.data.tags ?? [])[0] ?? 'Field note'

const firstSentence = (text: string) => text.split(/(?<=[.!?])\s/)[0]

// Short editorial lines for the five projects on the home page. The full
// project descriptions live on /projects/.
const workTaglines: Record<string, string> = {
  'marimo-bot': 'A desktop agent that grows with you.',
  'pixel-juice-studio': 'A browser tool for game juice. One file, nothing to install.',
  'background-swapper': 'A DeepSeek Harness plugin for your own photos.',
  'moss-toolbox': 'AI tools that know your business.',
  'x-buddy': 'Keyword glow, feed rules, and reply drafts for X.',
}

// The Pixel Juice project hero is an animated GIF, and X Buddy has no hero
// image. Use static thumbnails for the tiny home row so it stays light.
const workImages: Record<string, string> = {
  'pixel-juice-studio': '/images/pixel-juice-studio-banner.png',
  'background-swapper': '/images/background-swapper-blurred-space.png',
  'x-buddy': '/images/x-buddy-popup.png',
}

// The four threads are the real tags behind the journal. Counts are per tag,
// so they match the tag pages the links open.
const threadTags = [
  { tag: 'agents', label: 'Agents', color: 'var(--group-agents)' },
  { tag: 'local-first', label: 'Local-first', color: 'var(--group-local)' },
  { tag: 'workflow', label: 'Workflow', color: 'var(--group-workflow)' },
  { tag: 'launches', label: 'Launches', color: 'var(--group-launches)' },
]
const threads = threadTags.map((thread) => ({
  ...thread,
  count: posts.filter((post) => (post.data.tags ?? []).includes(thread.tag)).length,
}))

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Tarlow.space',
    url: 'https://tarlow.space/',
    description:
      'Field notes from Tarlow, a solo developer in Portland, Oregon. Local-first tools, building slowly, and a look in the past.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Tarlow',
    url: 'https://tarlow.space/',
    jobTitle: 'Developer',
    knowsAbout: ['local-first software', 'AI tools', 'web development'],
    sameAs: [
      'https://github.com/DevTarlow/',
      'https://bsky.app/profile/mossaistudio.bsky.social',
      'https://x.com/MossAIStudio',
    ],
  },
]
---

<BaseLayout
  view="home"
  description="A field journal from Tarlow, a solo developer in Portland, Oregon. Local-first tools, building slowly, and a look in the past."
  jsonLd={jsonLd}
>
  <main id="main-content">
    <div class="fj-home">
      <header class="fj-hero">
        <div class="fj-hero-copy">
          <p class="fj-eyebrow">Independent developer / Portland, Oregon</p>
          <h1>I build to learn,<br /><em>and write to remember.</em></h1>
          <p class="fj-deck">
            Local-first software, web apps, AI agents, and tools. This is where I keep the notes.
          </p>
          <div class="fj-actions">
            <a class="text-link" href="/blog/">
              Read the journal
              <span aria-hidden="true">&rarr;</span>
            </a>
            <a class="small-link" href="/projects/">See what I'm building</a>
          </div>
          <p class="fj-current">Currently building Marimo Bot and revamping the <span class="fj-nowrap">Moss Toolbox</span> product.</p>
        </div>

        <figure class="fj-portrait">
          <ContentImage
            src="/images/tarlow-past.webp"
            alt="Tarlow in a teal shirt"
            sizes="(max-width: 860px) 190px, 286px"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption><span>Tarlow</span><span>Portland, Oregon</span></figcaption>
        </figure>
      </header>

      <section class="fj-section" aria-labelledby="latest-notes">
        <div class="fj-section-head">
          <div>
            <p class="label">From the journal</p>
            <h2 id="latest-notes">Latest notes</h2>
          </div>
          <a class="small-link" href="/blog/">All {posts.length} notes</a>
        </div>

        <a class="fj-feature" href={`/blog/${latestPost.id}/`}>
          <div class="fj-feature-media">
            {
              latestPost.data.featuredimage ? (
                <ContentImage
                  src={latestPost.data.featuredimage}
                  alt=""
                  sizes="(max-width: 860px) 100vw, 560px"
                  loading="lazy"
                />
              ) : (
                <div class="fj-feature-placeholder" aria-hidden="true" />
              )
            }
          </div>
          <div class="fj-feature-copy">
            <p class="fj-feature-meta">
              <span>{latestDate}</span>
              <span>{latestMinutes} min read</span>
              <span>{latestTag}</span>
            </p>
            <h2>{latestPost.data.title}</h2>
            <p class="fj-feature-excerpt">{latestPost.data.description}</p>
            <span class="fj-feature-more">Read the note <span aria-hidden="true">&rarr;</span></span>
          </div>
        </a>

        <div class="fj-latest-rows">
          {
            recent.map((post) => (
              <a class="fj-latest-row" href={`/blog/${post.id}/`}>
                <span class="fj-latest-meta">
                  <span>{dateParts(post.data.pubDate).long}</span>
                  <span class="fj-latest-tag">{(post.data.tags ?? [])[0] ?? 'Field note'}</span>
                </span>
                <h3>{post.data.title}</h3>
                <span class="fj-latest-arrow" aria-hidden="true">&rarr;</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="fj-section" id="work" aria-labelledby="selected-work">
        <div class="fj-section-head">
          <div>
            <p class="label">Selected work</p>
            <h2 id="selected-work">Things I've been building</h2>
          </div>
          <a class="small-link" href="/projects/">All {allProjects.length} projects</a>
        </div>

        <div class="fj-work-list">
          {
            workProjects.map((project) => {
              const workImage = workImages[project.id] ?? project.data.image
              return (
                <a class="fj-work-row" href={`/projects/${project.id}/`}>
                  <div class="fj-work-thumb">
                    {workImage ? (
                      <ContentImage
                        src={workImage}
                        alt=""
                        sizes="78px"
                        loading="lazy"
                      />
                    ) : (
                      <span class="fj-work-placeholder" aria-hidden="true">
                        {project.data.title.charAt(0)}
                      </span>
                    )}
                  </div>
                  <div class="fj-work-copy">
                    <h3>{project.data.title.split(' - ')[0]}</h3>
                    <p>{workTaglines[project.id] ?? firstSentence(project.data.description)}</p>
                  </div>
                  <span class="fj-work-status">
                    {project.data.category === 'Development' ? 'In development' : (project.data.category ?? 'Project')}
                  </span>
                </a>
              )
            })
          }
        </div>
      </section>

      <section class="fj-threads" aria-labelledby="threads-title">
        <div class="fj-threads-head">
          <div>
            <p class="label">Threads</p>
            <h2 id="threads-title">The hot topics on the <em>workbench.</em></h2>
          </div>
        </div>

        <div class="fj-thread-grid">
          {
            threads.map((thread) => (
              <a
                class="fj-thread"
                href={`/blog/tags/${encodeURIComponent(thread.tag)}/`}
                style={`--g: ${thread.color}`}
              >
                <span class="fj-thread-star" aria-hidden="true" />
                <span class="fj-thread-name">{thread.label}</span>
                <span class="fj-thread-count">{thread.count} notes</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="fj-now" aria-labelledby="now-title">
        <div class="fj-now-copy">
          <p class="label"><span>Now / <span data-now-month>{nowMonth()}</span></span></p>
          <h2 id="now-title">Where I am today.</h2>
          <p>
            A long break from tech helped shape my purpose: helping others grow while building with
            grounded intention.
          </p>
          <a class="text-link" href="/about/">
            More about me
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="fj-now-facts">
          <div class="fj-now-fact">
            <span class="fj-now-key">Building</span>
            <span class="fj-now-value">
              {
                NOW.building.map((item, index) => (
                  <span>
                    {index > 0 && <span aria-hidden="true"> + </span>}
                    <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>
                  </span>
                ))
              }
            </span>
          </div>
          <div class="fj-now-fact">
            <span class="fj-now-key">Practicing</span>
            <span class="fj-now-value">{NOW.practicing}</span>
          </div>
          <div class="fj-now-fact">
            <span class="fj-now-key">Open to</span>
            <span class="fj-now-value">{NOW.openTo}</span>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
