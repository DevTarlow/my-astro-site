---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPublicBlog, getPublicProjects } from '../lib/posts'
import { dateParts } from '../lib/dates'
import { readingMinutes } from '../lib/reading'
import { FEATURED_POST_SLUG } from '../lib/site'
import ContentImage from '../components/ContentImage.astro'
import ConstellationAtlas from '../components/ConstellationAtlas.astro'
import NowCard from '../components/NowCard.astro'

const posts = await getPublicBlog()
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

const allProjects = await getPublicProjects()
const projectsById = new Map(allProjects.map((project) => [project.id, project]))
const selectedProjects = ['marimo-bot', 'copy-sprout', 'moss-toolbox']
  .map((id) => projectsById.get(id))
  .filter((project): project is NonNullable<typeof project> => Boolean(project))
const workProjects = selectedProjects.length > 0 ? selectedProjects : allProjects.slice(0, 3)

const featured = posts.find((post) => post.id === FEATURED_POST_SLUG) ?? posts[0]!
const latest = posts.filter((post) => post.id !== featured.id).slice(0, 4)

const earliest = [...posts].sort(
  (a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime(),
)[0]!
const since = earliest.data.pubDate.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  month: 'long',
  year: 'numeric',
})

const titleParts = featured.data.title.split(' - ')
const featuredMain = titleParts[0]
const featuredSub = titleParts.slice(1).join(' - ')
const featuredDate = dateParts(featured.data.pubDate).long
const featuredMinutes = readingMinutes(featured.body)
const featuredTags = (featured.data.tags ?? []).join(' / ')

const firstSentence = (text: string) => text.split(/(?<=[.!?])\s/)[0]

// Short editorial lines for the three objects on the home page. The full
// project descriptions live on /projects/.
const workTaglines: Record<string, string> = {
  'marimo-bot': 'A desktop agent that grows with you.',
  'copy-sprout': 'Plain-language writing tools for Etsy sellers.',
  'moss-toolbox': 'AI tools that know your business.',
}

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Tarlow.space',
    url: 'https://tarlow.space/',
    description:
      'Field notes from Tarlow, a solo developer in Portland, Oregon. Local-first tools, building slowly, and the long way back.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Tarlow',
    url: 'https://tarlow.space/',
    jobTitle: 'Developer',
    knowsAbout: ['local-first software', 'AI tools', 'web development'],
    sameAs: [
      'https://github.com/DevTarlow/',
      'https://bsky.app/profile/mossaistudio.bsky.social',
      'https://x.com/MossAIStudio',
    ],
  },
]
---

<BaseLayout
  view="home"
  description="A field journal from Tarlow, a solo developer in Portland, Oregon. Local-first tools, building slowly, and the long way back."
  jsonLd={jsonLd}
>
  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-top">
        <p class="hero-eyebrow" data-reveal="1">
          <span class="eyebrow-star" aria-hidden="true"></span>
          Independent developer / Portland, Oregon
        </p>
        <p class="hero-coord" data-reveal="2">A solo observatory<br />field notes since {since}</p>
      </div>

      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title" data-reveal="1">
            <span class="line">Quiet tools.</span>
            <span class="line">A slower life.</span>
          </h1>

          <div class="hero-lower">
            <p class="hero-intro" data-reveal="3">
              I make local-first software, write down what I learn, and try to build at the speed of a
              life rather than a launch cycle. After years of automation, a long step away, and a return
              to work I can stand behind, this is where the notes live.
            </p>

            <div class="hero-actions" data-reveal="4">
              <a class="primary-cta" href={`/blog/${featured.id}/`}>
                <span class="cta-orbit" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                  </svg>
                </span>
                Read a field note
              </a>
              <a class="quiet-link" href="#atlas">Look up at the atlas</a>
            </div>
          </div>
        </div>

        <aside class="hero-portrait" data-reveal="2" aria-label="Portrait of Tarlow">
          <div class="portrait-orbit" aria-hidden="true"></div>
          <div class="portrait-frame">
            <ContentImage
              src="/images/tarlow-past.webp"
              alt="Tarlow, smiling, in a teal shirt"
              sizes="(max-width: 720px) 168px, 310px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="portrait-cap">
            <span>Tarlow<br />builder + student</span>
            <span>Portland, OR<br />under the same sky</span>
          </div>
        </aside>
      </div>

      <div class="hero-foot">
        <p class="hero-count">
          <strong>{posts.length}</strong> essays &nbsp;/&nbsp; <strong>{allProjects.length}</strong> projects &nbsp;/&nbsp; since {since}
        </p>
        <a class="scroll-cue" href="#atlas">
          <span class="cue-line" aria-hidden="true"></span>
          Scroll to look up
        </a>
        <p class="hero-side-note">A solo site<br />no ads, no feed</p>
      </div>
    </section>

    <section class="section atlas" id="atlas" aria-labelledby="atlas-title">
      <div class="section-head">
        <div>
          <p class="label"><span class="label-line" aria-hidden="true"></span>02 / The atlas</p>
          <h2 id="atlas-title">A map of what I've been <em>circling.</em></h2>
        </div>
        <div class="section-aside">
          <p>
            Every entry is a star, grouped by the questions I keep returning to instead of what might
            perform. Hover, focus, or open the index to find your way around.
          </p>
          <p>{posts.length} entries / four constellations / one person's night sky.</p>
        </div>
      </div>

      <ConstellationAtlas posts={posts} featuredSlug={FEATURED_POST_SLUG} />
    </section>

    <section class="section journal" id="journal" aria-labelledby="journal-title">
      <div class="section-head">
        <div>
          <p class="label"><span class="label-line" aria-hidden="true"></span>03 / Recent entries</p>
          <h2 id="journal-title">Lately, on the <em>desk.</em></h2>
        </div>
        <div class="section-aside">
          <p>
            The most recent notes from the workbench. Agents, tools, and the strange things that happen
            after dark.
          </p>
          <p>Written when there is something worth saying. No schedule, no feed.</p>
        </div>
      </div>

      <a class="featured-entry" href={`/blog/${featured.id}/`} data-reveal="1">
        <div class="featured-visual">
          {
            featured.data.featuredimage ? (
              <ContentImage
                src={featured.data.featuredimage}
                alt=""
                sizes="(max-width: 900px) 100vw, 52vw"
              />
            ) : (
              <div class="featured-placeholder" aria-hidden="true"></div>
            )
          }
          <span class="featured-tag">From the journal</span>
        </div>
        <div class="featured-copy">
          <div class="featured-meta">
            <span class="featured-type">Featured entry</span>
            <span>{featuredDate}</span>
          </div>
          <h3>{featuredMain}{featuredSub ? <> - <em>{featuredSub}</em></> : null}</h3>
          <p class="featured-excerpt">{featured.data.description}</p>
          <div class="featured-foot">
            <span class="featured-read">
              Read the entry
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </span>
            <span class="read-time">{featuredMinutes} min read / {featuredTags}</span>
          </div>
        </div>
      </a>

      <div class="entry-list">
        {
          latest.map((post, index) => {
            return (
              <a class="entry-row" href={`/blog/${post.id}/`}>
                <span class="entry-num">{String(index + 1).padStart(3, '0')}</span>
                <span class="entry-date">{dateParts(post.data.pubDate).short}</span>
                <span class="entry-title">{post.data.title}</span>
                <span class="entry-tags">{(post.data.tags ?? []).slice(0, 2).join(' / ')}</span>
                <span class="entry-arrow" aria-hidden="true">↗</span>
              </a>
            )
          })
        }
      </div>

      <div class="journal-foot">
        <p class="journal-note">Written when there is something worth saying. No schedule, no feed.</p>
        <a class="text-link" href="/blog/">
          Open the whole journal
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </section>

    <section class="section work" id="work" aria-labelledby="work-title">
      <div class="section-head">
        <div>
          <p class="label"><span class="label-line" aria-hidden="true"></span>04 / The work</p>
          <h2 id="work-title">Things I've put into <em>orbit.</em></h2>
        </div>
        <div class="section-aside">
          <p>
            A few of the products and experiments from Moss AI Studio. Built to be useful, respectful of
            your data, and quiet about it.
          </p>
          <p>{allProjects.length} projects in orbit. Three close enough to see.</p>
        </div>
      </div>

      <div class="work-grid">
        {
          workProjects.map((project, index) => (
            <a class="work-card" href={`/projects/${project.id}/`}>
              <div class="work-visual">
                {project.data.image ? (
                  <ContentImage
                    src={project.data.image}
                    alt=""
                    sizes="(max-width: 760px) 100vw, 33vw"
                  />
                ) : (
                  <div class="work-placeholder" aria-hidden="true">
                    {project.data.title.charAt(0)}
                  </div>
                )}
                <span class="work-index">
                  {String(index + 1).padStart(2, '0')} / {(project.data.tags ?? [])[0] ?? 'Studio'}
                </span>
                <span class="work-status">{project.data.category ?? 'Project'}</span>
              </div>
              <div class="work-copy">
                <div>
                  <h3>{project.data.title.split(' - ')[0]}</h3>
                  <p>{workTaglines[project.id] ?? firstSentence(project.data.description)}</p>
                </div>
                <span class="work-arrow" aria-hidden="true">↗</span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="work-foot">
        <a class="text-link" href="/projects/">
          All {allProjects.length} projects
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </section>

    <section class="now-band" aria-labelledby="now-title">
      <div class="now-inner">
        <div>
          <h2 class="label" id="now-title"><span class="label-line" aria-hidden="true"></span>05 / Where I am today</h2>
          <blockquote class="now-quote">
            I found more of myself in that time, enough to grow, and I came back wanting to help other
            people grow too, and to work in a <em>purer way.</em>
          </blockquote>
          <p class="now-attrib">From the long way back / the years away</p>
        </div>

        <NowCard />
      </div>
    </section>
  </main>
</BaseLayout>
