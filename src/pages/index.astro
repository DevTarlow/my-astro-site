---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPublicBlog } from '../lib/posts'
import { excerpt } from '../lib/excerpt'
import ContentImage from '../components/ContentImage.astro'
import PostActivityGraph from '../components/PostActivityGraph.astro'

const posts = await getPublicBlog()
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
---

<BaseLayout description="A corner of the web built with intention. Here you'll find posts about my latest projects and research.">
  <main class="mx-auto max-w-[65ch] px-6 py-20">
    <section class="mb-20 text-center">
      <img
        src="/images/tarlow-cropped-headshot-small.jpg"
        alt="Tarlow"
        class="mx-auto w-32 h-32 rounded-full object-cover border-2 border-terracotta/20"
        loading="lazy"
      />
      <p class="mt-4 text-lg text-ink/60 font-sans">
        <strong>Hello! 👋 I'm Tarlow.</strong>
      </p>
      <div class="mt-5 flex items-center justify-center gap-3">
        <a
          href="https://x.com/MossAIStudio"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Moss AI Studio on X"
          class="inline-flex items-center justify-center h-9 w-9 rounded-full border border-ink/10 text-ink/60 hover:text-terracotta hover:border-terracotta/30 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a
          href="https://bsky.app/profile/mossaistudio.bsky.social"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Moss AI Studio on Bluesky"
          class="inline-flex items-center justify-center h-9 w-9 rounded-full border border-ink/10 text-ink/60 hover:text-terracotta hover:border-terracotta/30 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 530" class="h-4 w-auto" fill="currentColor">
            <path d="M135.72 44.03C202.216 93.951 274.842 195.287 300 249.844c25.158-54.557 97.784-155.893 164.28-205.814C512.227 1.244 600-26.116 600 59.393c0 19.285-11.292 161.953-17.918 185.119-23.002 80.367-106.823 100.882-181.354 88.453 130.324 22.186 163.455 95.542 91.884 168.936-135.943 139.324-195.473-34.988-210.777-79.592-2.824-8.256-4.147-12.115-4.147-8.772 0-3.343-1.323-.516-4.147 8.772-15.304 44.604-74.834 218.916-210.777 79.592-71.571-73.394-38.44-146.75 91.884-168.936-74.531 12.429-158.352-8.086-181.354-88.453C11.292 221.346 0 78.678 0 59.393 0-26.116 87.773-1.244 135.72 44.03Z"/>
          </svg>
        </a>
      </div>
      <div class="mx-auto mt-6 h-0.5 w-12 rounded bg-terracotta"></div>
      <p class="mt-10 text-sm text-ink/60 leading-relaxed max-w-prose mx-auto">
        I like to build things, help people, learn, and write.
      </p>

      <PostActivityGraph />
    </section>

    <h2 class="font-sans text-2xl font-semibold tracking-tight mb-8">
      Latest Posts
    </h2>

    <ul class="space-y-12">
      {
        posts.slice(0, 5).map((post) => (
          <li>
            <article>
              {
                post.data.featuredimage && (
                  <a href={`/blog/${post.id}/`}>
                    <ContentImage
                      src={post.data.featuredimage}
                      alt=""
                      class="w-full h-36 object-cover rounded-lg mb-3"
                    />
                  </a>
                )
              }
              <time class="block text-sm text-ink/40 mb-1.5">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <a
                href={`/blog/${post.id}/`}
                class="font-sans text-xl text-ink no-underline hover:text-terracotta transition-colors"
              >
                {post.data.title}
              </a>
              <p class="mt-2 text-sm text-ink/60 leading-relaxed">
                {excerpt(post.body ?? '', 250)}
              </p>
              <a
                href={`/blog/${post.id}/`}
                class="mt-2 inline-block text-sm text-terracotta no-underline hover:opacity-80 transition-opacity"
              >
                Read More →
              </a>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="mt-14 text-center">
      <a
        href="/blog/"
        class="font-sans text-lg text-terracotta no-underline transition-opacity hover:opacity-80 border-b-2 border-terracotta pb-0.5"
      >
        Read More →
      </a>
    </div>
  </main>
</BaseLayout>
