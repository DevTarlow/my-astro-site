---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404" noindex view="page">
  <main id="main-content">
    <div class="not-found">
      <p class="label"><span class="label-line" aria-hidden="true"></span>404 / off the map</p>
      <h1>You've drifted<br /><em>off the map.</em></h1>
      <p class="not-found-copy">
        This page isn't here. Maybe it was never built, or maybe it moved while you were looking up.
      </p>
      <div class="not-found-links">
        <a class="primary-cta" href="/">
          <span class="cta-orbit" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M19 12H5M11 18l-6-6 6-6"></path>
            </svg>
          </span>
          Back to the observatory
        </a>
        <a class="quiet-link" href="/blog/">Look through the journal</a>
      </div>
    </div>
  </main>
</BaseLayout>
