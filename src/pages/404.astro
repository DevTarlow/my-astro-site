---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404" noindex view="page">
  <main id="main-content">
    <div class="not-found">
      <p class="label">404 / off the path</p>
      <h1>You've drifted<br /><em>off the path.</em></h1>
      <p class="not-found-copy">
        This page isn't here. Maybe it was never built, or maybe it moved while you were looking up.
      </p>
      <div class="not-found-links">
        <a class="text-link" href="/">Back home <span aria-hidden="true">&rarr;</span></a>
        <a class="text-link" href="/blog/">Look through the journal <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </main>
</BaseLayout>
