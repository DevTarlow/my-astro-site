---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404" noindex view="page">
  <main id="main-content">
    <div class="not-found">
      <p class="label">404 / page not found</p>
      <h1>Nothing at <em>this link.</em></h1>
      <p class="not-found-copy">
        This page isn't here. It may have moved, or the URL might have a typo.
      </p>
      <div class="not-found-links">
        <a class="text-link" href="/">Back home <span aria-hidden="true">&rarr;</span></a>
        <a class="text-link" href="/blog/">Browse the journal <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </main>
</BaseLayout>
