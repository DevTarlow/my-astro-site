---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { render } from 'astro:content'
import '../../styles/prose.css'
import ContentImage from '../../components/ContentImage.astro'
import ImageZoom from '../../components/ImageZoom.astro'
import CodeCopy from '../../components/CodeCopy.astro'
import RelatedPosts from '../../components/RelatedPosts.astro'
import ShareButtons from '../../components/ShareButtons.astro'
import { getPublicBlog, getRelatedPosts } from '../../lib/posts'
import { dateParts } from '../../lib/dates'
import { readingMinutes } from '../../lib/reading'

export async function getStaticPaths() {
  const posts = await getPublicBlog()
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
if (!post) {
  return new Response(null, { status: 404 })
}

const { Content } = await render(post)
const allPosts = await getPublicBlog()
const related = getRelatedPosts(post, allPosts)
const date = dateParts(post.data.pubDate)
const minutes = readingMinutes(post.body)
const tags = post.data.tags ?? []

// BlogPosting gives search engines the author, dates and tags they need for
// article rich results.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  url: `https://tarlow.space/blog/${post.id}/`,
  mainEntityOfPage: `https://tarlow.space/blog/${post.id}/`,
  author: { '@type': 'Person', name: 'Tarlow', url: 'https://tarlow.space/about/' },
  publisher: { '@type': 'Person', name: 'Tarlow', url: 'https://tarlow.space/' },
  ...(post.data.tags?.length ? { keywords: post.data.tags.join(', ') } : {}),
  ...(post.data.featuredimage
    ? { image: `https://tarlow.space${post.data.featuredimage}` }
    : {}),
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.featuredimage}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  articleTags={tags}
  jsonLd={jsonLd}
  view="essay"
>
  <div class="essay-progress" aria-hidden="true">
    <div class="essay-progress-bar" id="essay-progress-bar"></div>
  </div>

  <main id="main-content">
    <article class="essay">
      <div class="essay-crumb">
        <a href="/blog/">Journal</a>
        <span class="crumb-sep">/</span>
        <span>Field note</span>
      </div>

      <header class="essay-head">
        <div class="essay-kicker">
          {tags[0] && <span class="kicker-type">{tags[0]}</span>}
          <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{date.long}</time>
          <span>{minutes} min read</span>
        </div>

        <h1>{post.data.title}</h1>
        <p class="essay-deck">{post.data.description}</p>

        <p class="essay-byline">
          <span><strong>Words + code</strong> / Tarlow</span>
          <span>Portland, Oregon</span>
          <span>Published {post.data.pubDate.toISOString().slice(0, 10).replaceAll('-', '.')}</span>
        </p>
      </header>

      {
        post.data.featuredimage && (
          <figure class="essay-hero">
            <ContentImage
              src={post.data.featuredimage}
              alt=""
              sizes="(max-width: 1000px) 100vw, 1100px"
              loading="eager"
            />
            <figcaption>
              <span>From the field notes.</span>
              <span>Entry / {post.id.replaceAll('-', ' ')}</span>
            </figcaption>
          </figure>
        )
      }

      <h2 class="visually-hidden">The entry</h2>
      <div class="prose-custom">
        <Content />
      </div>

      <div class="essay-after">
        <div class="essay-tags" aria-label="Tags">
          {tags.map((tag) => (
            <a class="essay-tag" href={`/blog/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
          ))}
        </div>

        <ShareButtons title={post.data.title} />

        <a class="next-entry" href="/blog/">
          <span>
            <span class="next-label">Return to</span>
            <span class="next-title">The journal</span>
          </span>
          <span class="next-arrow" aria-hidden="true">→</span>
        </a>

        <RelatedPosts posts={related} />
      </div>
    </article>
  </main>

  <ImageZoom />
  <CodeCopy />
</BaseLayout>
