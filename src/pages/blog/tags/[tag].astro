---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PostCard from '../../../components/PostCard.astro'
import { getPublicBlog } from '../../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPublicBlog()
  const tags = new Set<string>()
  for (const post of posts) {
    for (const tag of post.data.tags ?? []) tags.add(tag)
  }
  return [...tags].map((tag) => ({ params: { tag } }))
}

const tag = Astro.params.tag!
const posts = await getPublicBlog()
const filtered = posts
  .filter((post) => (post.data.tags ?? []).includes(tag))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
---

<BaseLayout title={`#${tag}`} description={`Field notes tagged with "${tag}".`} view="page">
  <main id="main-content">
    <div class="page-shell">
      <header class="page-head">
        <p class="label"><span class="label-line" aria-hidden="true"></span>Journal / tag</p>
        <div class="page-head-row">
          <h1>#<em>{tag}</em></h1>
          <div class="page-head-aside">
            <p>
              {filtered.length} {filtered.length === 1 ? 'entry' : 'entries'} in this thread. Follow it, or
              wander back into the archive.
            </p>
            <p><a class="text-link" href="/blog/tags/">All tags</a></p>
          </div>
        </div>
      </header>

      <div class="post-list">
        {
          filtered.map((post) => (
            <PostCard post={post} />
          ))
        }
      </div>

      <div class="archive-back">
        <a class="text-link" href="/blog/">← Back to the journal</a>
      </div>
    </div>
  </main>
</BaseLayout>
