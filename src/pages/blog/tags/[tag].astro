---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PostCard from '../../../components/PostCard.astro'
import { getPublicBlog } from '../../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPublicBlog()
  const tags = new Set<string>()
  for (const post of posts) {
    for (const tag of post.data.tags ?? []) {
      tags.add(tag)
    }
  }
  return [...tags].map((tag) => ({
    params: { tag },
  }))
}

const tag = Astro.params.tag!
const posts = await getPublicBlog()
const filtered = posts
  .filter((post) => (post.data.tags ?? []).includes(tag))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
---

<BaseLayout title={`#${tag}`} description={`Posts tagged with "${tag}".`}>
  <main class="mx-auto max-w-[65ch] px-6 py-20">
    <header class="mb-12">
      <a
        href="/blog/tags/"
        class="inline-block text-sm text-terracotta no-underline hover:opacity-80 transition-opacity mb-6"
      >
        ← All Tags
      </a>
      <h1 class="font-sans text-3xl font-semibold tracking-tight">
        #<span class="text-terracotta">{tag}</span>
      </h1>
      <p class="mt-2 text-sm text-muted">
        {filtered.length} {filtered.length === 1 ? 'post' : 'posts'}
      </p>
      <div class="mt-4 h-0.5 w-12 rounded bg-terracotta"></div>
    </header>

    <ul class="space-y-12">
      {
        filtered.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
