---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import BlogSearch from '../../../components/BlogSearch.astro'
import Pagination from '../../../components/Pagination.astro'
import PostCard from '../../../components/PostCard.astro'
import { getPublicBlog } from '../../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPublicBlog()
  const totalPages = Math.ceil(posts.length / 5)
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }))
}

const posts = await getPublicBlog()
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

const pageSize = 5
const totalPages = Math.ceil(posts.length / pageSize)
const currentPage = Number(Astro.params.page)
const offset = (currentPage - 1) * pageSize
const pagePosts = posts.slice(offset, offset + pageSize)
---

<BaseLayout
  title={`Journal - Page ${currentPage}`}
  description="Field notes from Tarlow on local-first tools, agents, building slowly, and a look in the past."
  view="page"
>
  <main id="main-content">
    <div class="fj-journal-page">
      <header class="fj-journal-head">
        <p class="label">Journal / page {currentPage} of {totalPages}</p>
        <h1 id="journal-title">The journal, <em>page {currentPage}.</em></h1>
        <p class="fj-journal-deck">
          More entries on local-first tools, agents, and the long way back. Page {currentPage} of
          {totalPages}.
        </p>
      </header>

      <div class="fj-journal-tools">
        <BlogSearch />
        <a class="small-link" href="/blog/tags/">Browse by tag</a>
      </div>

      <div id="default-content">
        <div class="post-list">
          {
            pagePosts.map((post) => (
              <PostCard post={post} />
            ))
          }
        </div>

        <Pagination currentPage={currentPage} totalPages={totalPages} />
      </div>

      <div id="search-results" class="search-results hidden" aria-live="polite" role="status"></div>
    </div>
  </main>
</BaseLayout>
