---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Sidebar from '../../../components/Sidebar.astro'
import BlogSearch from '../../../components/BlogSearch.astro'
import Pagination from '../../../components/Pagination.astro'
import PostCard from '../../../components/PostCard.astro'
import { getPublicBlog } from '../../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPublicBlog()
  const totalPages = Math.ceil(posts.length / 5)
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }))
}

const posts = await getPublicBlog()
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

const pageSize = 5
const totalPages = Math.ceil(posts.length / pageSize)
const currentPage = Number(Astro.params.page)
const offset = (currentPage - 1) * pageSize
const pagePosts = posts.slice(offset, offset + pageSize)
---

<BaseLayout
  title={`Journal - Page ${currentPage}`}
  description="Field notes from Tarlow on local-first tools, agents, building slowly, and the long way back."
  view="page"
>
  <main id="main-content">
    <div class="page-shell">
      <header class="page-head">
        <p class="label"><span class="label-line" aria-hidden="true"></span>Journal / page {currentPage} of {totalPages}</p>
        <div class="page-head-row">
          <h1>The thoughts,<br /><em>in one place.</em></h1>
          <div class="page-head-aside">
            <p>
              {posts.length} entries on local-first tools, agents, and the long way back. Page {currentPage} of
              {totalPages}.
            </p>
            <p><a class="text-link" href="/blog/tags/">Browse by tag</a></p>
          </div>
        </div>
      </header>

      <div class="journal-layout">
        <div class="journal-main">
          <BlogSearch />

          <div id="default-content">
            <div class="post-list">
              {
                pagePosts.map((post) => (
                  <PostCard post={post} />
                ))
              }
            </div>

            <Pagination currentPage={currentPage} totalPages={totalPages} />
          </div>

          <div id="search-results" class="search-results hidden" aria-live="polite" role="status"></div>
        </div>

        <aside class="journal-aside" aria-label="Journal sidebar">
          <Sidebar showRecent />
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>
