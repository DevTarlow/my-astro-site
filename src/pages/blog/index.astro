---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BlogSearch from '../../components/BlogSearch.astro'
import Pagination from '../../components/Pagination.astro'
import PostCard from '../../components/PostCard.astro'
import { getPublicBlog } from '../../lib/posts'

const posts = await getPublicBlog()
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

const pageSize = 5
const totalPages = Math.ceil(posts.length / pageSize)
const pagePosts = posts.slice(0, pageSize)
---

<BaseLayout
  title="Journal"
  description="Field notes from Tarlow on local-first tools, agents, building slowly, and a look in the past."
  view="page"
>
  <main id="main-content">
    <div class="fj-journal-page">
      <header class="fj-journal-head">
        <p class="label">The journal</p>
        <h1 id="journal-title">Every note, <em>in one place.</em></h1>
        <p class="fj-journal-deck">
          {posts.length} entries on local-first tools, agents, and the long way back. Written when there
          is something worth saying, not on a schedule.
        </p>
      </header>

      <div class="fj-journal-tools">
        <BlogSearch />
        <a class="small-link" href="/blog/tags/">Browse by tag</a>
      </div>

      <div id="default-content">
        <div class="post-list">
          {
            pagePosts.map((post) => (
              <PostCard post={post} />
            ))
          }
        </div>

        {totalPages > 1 && <Pagination currentPage={1} totalPages={totalPages} />}
      </div>

      <div id="search-results" class="search-results hidden" aria-live="polite" role="status"></div>
    </div>
  </main>
</BaseLayout>
