---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import { getPublicProjects } from '../../lib/posts'
const projects = await getPublicProjects()
projects.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

const latestImage = projects[0]?.data.image
---

<BaseLayout title="Projects" description="Building what I love - showcase of my projects." image={latestImage}>
  <main class="mx-auto max-w-[90rem] px-6 py-20">
    <header class="mb-16 text-center">
      <h1 class="font-serif text-5xl font-semibold tracking-tight leading-tight">
        Things I've Built
      </h1>
      <p class="mt-4 text-lg text-ink/60 font-sans">
        Documenting, sharing, and learning.
      </p>
      <div class="mx-auto mt-6 h-0.5 w-12 rounded bg-terracotta"></div>
    </header>

    <div class="mx-auto max-w-4xl flex flex-col gap-6">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </main>
</BaseLayout>
