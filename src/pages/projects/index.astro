---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProjectFeaturedCard from '../../components/ProjectFeaturedCard.astro'
import ProjectIndexRow from '../../components/ProjectIndexRow.astro'
import { getProjects, toDisplay, groupByYear } from '../../lib/project-browse'

const projects = await getProjects()
const rows = toDisplay(projects)
const featured = rows.filter((row) => row.project.data.featured)
const remaining = groupByYear(rows.filter((row) => !row.project.data.featured))

const latestImage = projects[0]?.data.image
---

<BaseLayout
  title="Projects"
  description="Local-first tools, agents, and useful experiments from Tarlow's one-person studio."
  image={latestImage}
  view="page"
>
  <main id="main-content">
    <div class="page-shell">
      <header class="page-head">
        <p class="label"><span class="label-line" aria-hidden="true"></span>Work / the collection</p>
        <div class="page-head-row">
          <h1>Things that left<br /><em>the desk.</em></h1>
          <div class="page-head-aside">
            <p>
              {projects.length} projects from Moss AI Studio and the workbench around it. Small, local-first,
              and made to be lived with.
            </p>
            <p>Some are in orbit. Some are still being built.</p>
          </div>
        </div>
      </header>

      {
        featured.length > 0 && (
          <section class="projects-featured" aria-labelledby="projects-featured">
            <h2 class="label" id="projects-featured"><span class="label-line" aria-hidden="true"></span>Featured / in the field</h2>
            <div class="projects-featured-list">
              {featured.map((item) => (
                <ProjectFeaturedCard item={item} />
              ))}
            </div>
          </section>
        )
      }

      {
        remaining.length > 0 && (
          <section class="projects-index" aria-labelledby="projects-index">
            <div class="projects-index-head">
              <h2 class="label" id="projects-index"><span class="label-line" aria-hidden="true"></span>Everything else</h2>
              <p class="projects-index-note">Grouped by year / newest first.</p>
            </div>

            {remaining.map(([year, yearRows]) => (
              <div class="project-year">
                <p class="project-year-label">{year}</p>
                <div class="project-year-list">
                  {yearRows.map((item) => (
                    <ProjectIndexRow item={item} />
                  ))}
                </div>
              </div>
            ))}
          </section>
        )
      }

      <div class="archive-back">
        <a class="text-link" href="/about/">The person behind the work</a>
      </div>
    </div>
  </main>
</BaseLayout>
