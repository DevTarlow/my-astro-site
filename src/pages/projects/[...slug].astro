---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { render } from 'astro:content'
import '../../styles/prose.css'
import ContentImage from '../../components/ContentImage.astro'
import ImageZoom from '../../components/ImageZoom.astro'
import { getPublicProjects } from '../../lib/posts'
import { dateParts } from '../../lib/dates'
import { categoryClass } from '../../lib/project-browse'

export async function getStaticPaths() {
  const projects = await getPublicProjects()
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }))
}

const { project } = Astro.props
if (!project) {
  return new Response(null, { status: 404 })
}

const { Content } = await render(project)
const date = dateParts(project.data.pubDate)
const tags = project.data.tags ?? []

// CreativeWork rather than BlogPosting: a project page is not an article.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': project.data.category === 'Launched' ? 'SoftwareApplication' : 'CreativeWork',
  name: project.data.title,
  description: project.data.description,
  datePublished: project.data.pubDate.toISOString(),
  url: `https://tarlow.space/projects/${project.id}/`,
  author: { '@type': 'Person', name: 'Tarlow', url: 'https://tarlow.space/about/' },
  ...(project.data.tags?.length ? { keywords: project.data.tags.join(', ') } : {}),
  ...(project.data.url ? { sameAs: project.data.url } : {}),
  ...(project.data.image ? { image: `https://tarlow.space${project.data.image}` } : {}),
}
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  image={project.data.image}
  ogType="article"
  publishedTime={project.data.pubDate.toISOString()}
  articleTags={tags}
  jsonLd={jsonLd}
  view="page"
>
  <main id="main-content">
    <article class="project-page">
      <div class="project-crumb">
        <a href="/projects/">Work</a>
        <span class="crumb-sep">/</span>
        <span>Project note</span>
      </div>

      <header class="project-head">
        <div class="project-kicker-row">
          {project.data.category && <span class={categoryClass(project.data.category)}>{project.data.category}</span>}
          <time datetime={project.data.pubDate.toISOString().slice(0, 10)}>{date.long}</time>
        </div>

        <h1>{project.data.title}</h1>
        <p class="project-deck">{project.data.description}</p>

        <div class="project-foot-meta">
          {
            tags.length > 0 && (
              <ul class="project-tags" aria-label="Tags">
                {tags.map((tag) => <li>#{tag}</li>)}
              </ul>
            )
          }
          <div class="project-actions">
            {
              project.data.github && (
                <a href={project.data.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
              )
            }
            {
              project.data.url && (
                <a href={project.data.url} target="_blank" rel="noopener noreferrer">Visit ↗</a>
              )
            }
          </div>
        </div>
      </header>

      {
        project.data.image && (
          <figure class="project-hero">
            <ContentImage
              src={project.data.image}
              alt=""
              sizes="(max-width: 1000px) 100vw, 1100px"
              loading="eager"
            />
            <figcaption>
              <span>{project.data.title.split(' - ')[0]}</span>
              <span>From the workbench</span>
            </figcaption>
          </figure>
        )
      }

      <h2 class="visually-hidden">Project details</h2>
      <div class="prose-custom project-prose">
        <Content />
      </div>

      <footer class="project-footer">
        <a class="text-link" href="/projects/">
          ← All projects
        </a>
        {
          project.data.url && (
            <a class="btn" href={project.data.url} target="_blank" rel="noopener noreferrer">
              Visit the project ↗
            </a>
          )
        }
      </footer>
    </article>
  </main>

  <ImageZoom />
</BaseLayout>
